<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Utility traits: mostly worth something once the creature is tamed. Most are
       revealed when it joins the colony, so taming an unknown bastle is a gamble.
       The Utility tag puts a trait in the separate utility roll (Generation settings)
       instead of the main one, and keeps its points out of the health bonus. -->

  <!-- Diet: lives on rock. Hidden; revealed by eating a chunk (diet default). -->
  <BastleFramework.BastleTraitDef>
    <defName>BF_Rockgut</defName>
    <label>rockgut</label>
    <description>It grinds stone in its gut and lives on it when there is nothing better.</description>
    <namePrefix>rockgut</namePrefix>
    <allowMechanoids>false</allowMechanoids>
    <tags><li>Utility</li></tags>
    <diet>
      <extraFoods>
        <li><thing>ChunkGranite</thing><nutrition>0.5</nutrition></li>
        <li><thing>ChunkLimestone</thing><nutrition>0.5</nutrition></li>
        <li><thing>ChunkMarble</thing><nutrition>0.5</nutrition></li>
        <li><thing>ChunkSandstone</thing><nutrition>0.5</nutrition></li>
        <li><thing>ChunkSlate</thing><nutrition>0.5</nutrition></li>
      </extraFoods>
    </diet>
  </BastleFramework.BastleTraitDef>

  <BastleFramework.BastleTraitDef>
    <defName>BF_Tireless</defName>
    <label>tireless</label>
    <description>It never sleeps, and never seems to tire.</description>
    <namePrefix>tireless</namePrefix>
    <rarity>Rare</rarity>
    <allowMechanoids>false</allowMechanoids>
    <exclusionTags><li>BF_Rest</li></exclusionTags>
    <tags><li>Utility</li></tags>
    <discoverWhen>
      <li>JoinsColony</li>
      <li>Dies</li>
    </discoverWhen>
    <stage>
      <disablesNeeds><li>Rest</li></disablesNeeds>
    </stage>
  </BastleFramework.BastleTraitDef>

  <BastleFramework.BastleTraitDef>
    <defName>BF_Frugal</defName>
    <label>frugal</label>
    <description>It needs far less food than others of its kind.</description>
    <namePrefix>frugal</namePrefix>
    <scalesWithRarity>true</scalesWithRarity>
    <allowMechanoids>false</allowMechanoids>
    <exclusionTags><li>BF_Hunger</li></exclusionTags>
    <tags><li>Utility</li></tags>
    <discoverWhen>
      <li>JoinsColony</li>
      <li>Dies</li>
    </discoverWhen>
    <stage>
      <hungerRateFactor>0.75</hungerRateFactor>
    </stage>
  </BastleFramework.BastleTraitDef>

  <BastleFramework.BastleTraitDef>
    <defName>BF_Meaty</defName>
    <label>meaty</label>
    <description>Thick muscle and fat. It gives much more meat when butchered.</description>
    <namePrefix>meaty</namePrefix>
    <scalesWithRarity>true</scalesWithRarity>
    <requiresFlesh>true</requiresFlesh>
    <disallowConstructs>true</disallowConstructs>
    <tags><li>Utility</li></tags>
    <discoverWhen>
      <li>JoinsColony</li>
      <li>Dies</li>
    </discoverWhen>
    <stage>
      <statFactors>
        <MeatAmount>1.3</MeatAmount>
      </statFactors>
    </stage>
  </BastleFramework.BastleTraitDef>

  <BastleFramework.BastleTraitDef>
    <defName>BF_FineHided</defName>
    <label>fine-hided</label>
    <description>A broad, flawless hide. It gives much more leather when butchered.</description>
    <namePrefix>fine-hided</namePrefix>
    <scalesWithRarity>true</scalesWithRarity>
    <requiresFlesh>true</requiresFlesh>
    <disallowConstructs>true</disallowConstructs>
    <tags><li>Utility</li></tags>
    <discoverWhen>
      <li>JoinsColony</li>
      <li>Dies</li>
    </discoverWhen>
    <stage>
      <statFactors>
        <LeatherAmount>1.3</LeatherAmount>
      </statFactors>
    </stage>
  </BastleFramework.BastleTraitDef>

  <BastleFramework.BastleTraitDef>
    <defName>BF_Packbeast</defName>
    <label>packbeast</label>
    <description>A broad back and strong legs. It can haul and carry far more than others of its kind.</description>
    <namePrefix>packbeast</namePrefix>
    <scalesWithRarity>true</scalesWithRarity>
    <tags><li>Utility</li></tags>
    <discoverWhen>
      <li>JoinsColony</li>
      <li>Dies</li>
    </discoverWhen>
    <stage>
      <statFactors>
        <CarryingCapacity>1.3</CarryingCapacity>
      </statFactors>
    </stage>
  </BastleFramework.BastleTraitDef>

  <!-- Visible: the gold sheen gives it away. Only on races that are shorn. -->
  <BastleFramework.BastleTraitDef>
    <defName>BF_GoldenFleeced</defName>
    <label>golden-fleeced</label>
    <description>Its fleece grows as fine gold thread. Shearing it gives gold instead of wool, about half as many units.</description>
    <namePrefix>golden-fleeced</namePrefix>
    <rarity>Rare</rarity>
    <visible>true</visible>
    <requiresFlesh>true</requiresFlesh>
    <disallowConstructs>true</disallowConstructs>
    <allowHumanlikes>false</allowHumanlikes>
    <tags><li>Utility</li></tags>
    <overlays>
      <li>
        <color>(1.0, 0.82, 0.3, 0.3)</color>
        <pulseSpeed>0.3</pulseSpeed>
        <pulseMin>0.6</pulseMin>
      </li>
    </overlays>
    <products>
      <woolDef>Gold</woolDef>
      <woolAmountFactor>0.5</woolAmountFactor>
    </products>
  </BastleFramework.BastleTraitDef>

  <!-- Cosmetic light. Cheap, since it does nothing else. -->
  <BastleFramework.BastleTraitDef>
    <defName>BF_Luminous</defName>
    <label>luminous</label>
    <description>It gives off a soft, steady light, enough to light a room.</description>
    <namePrefix>luminous</namePrefix>
    <visible>true</visible>
    <pointCost>0.5</pointCost>
    <tags><li>Utility</li></tags>
    <overlays>
      <li>
        <color>(1.0, 0.95, 0.75, 0.2)</color>
        <pulseSpeed>0.4</pulseSpeed>
        <pulseMin>0.7</pulseMin>
      </li>
    </overlays>
    <glow>
      <radius>6</radius>
      <color>(255,240,200,0)</color>
    </glow>
  </BastleFramework.BastleTraitDef>

  <!-- Temperature tolerance: lets a tamed creature live in a harsher biome or work
       outside in winter. Flaming and Emberborn also shift comfort, but their fire
       resistance is a combat trait, so they stay in the main roll. -->
  <BastleFramework.BastleTraitDef>
    <defName>BF_Frostfur</defName>
    <label>frostfur</label>
    <description>A thick, frost-white coat keeps it comfortable in bitter cold.</description>
    <namePrefix>frostfur</namePrefix>
    <scalesWithRarity>true</scalesWithRarity>
    <requiresFlesh>true</requiresFlesh>
    <disallowConstructs>true</disallowConstructs>
    <exclusionTags><li>BF_Element</li></exclusionTags>
    <tags>
      <li>Utility</li>
      <li>Cold</li>
    </tags>
    <discoverWhen>
      <li>JoinsColony</li>
      <li>Dies</li>
    </discoverWhen>
    <stage>
      <statOffsets>
        <ComfyTemperatureMin>-25</ComfyTemperatureMin>
      </statOffsets>
    </stage>
  </BastleFramework.BastleTraitDef>

  <BastleFramework.BastleTraitDef>
    <defName>BF_Sunhardened</defName>
    <label>sunhardened</label>
    <description>It is comfortable in heat that would kill others of its kind.</description>
    <namePrefix>sunhardened</namePrefix>
    <scalesWithRarity>true</scalesWithRarity>
    <tags>
      <li>Utility</li>
      <li>Heat</li>
    </tags>
    <discoverWhen>
      <li>JoinsColony</li>
      <li>Dies</li>
    </discoverWhen>
    <stage>
      <statOffsets>
        <ComfyTemperatureMax>25</ComfyTemperatureMax>
      </statOffsets>
    </stage>
  </BastleFramework.BastleTraitDef>

</Defs>
