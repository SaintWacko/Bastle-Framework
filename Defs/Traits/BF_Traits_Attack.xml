<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Hidden attack: revealed the first time it bites with the venomous fangs. -->
  <BastleFramework.BastleTraitDef>
    <defName>BF_Venomous</defName>
    <label>venomous</label>
    <description>Its bite carries a poison that builds up in the victim's body.</description>
    <rumor>has a poisoned bite</rumor>
    <namePrefix>venomous</namePrefix>
    <!-- Scales with rarity; from Epic up its fangs are replaced by stronger ones. -->
    <scalesWithRarity>true</scalesWithRarity>
    <discoverWhen>
      <li>UsesGrantedVerb</li>
      <li>Dies</li>
    </discoverWhen>
    <hediffs>
      <li><hediff>BF_VenomFangs</hediff></li>
    </hediffs>
    <rarityOverrides>
      <li>
        <minRarity>Epic</minRarity>
        <label>virulent</label>
        <namePrefix>virulent</namePrefix>
        <description>Its bite carries a virulent poison that overwhelms the victim within moments.</description>
        <rumor>has a bite whose poison overwhelms a victim within moments</rumor>
        <hediffs>
          <li><hediff>BF_VirulentFangs</hediff></li>
        </hediffs>
      </li>
    </rarityOverrides>
  </BastleFramework.BastleTraitDef>

  <!-- Hidden ability, cast by the AI in combat. Biotech only (vanilla fire spew effect). -->
  <BastleFramework.BastleTraitDef MayRequire="Ludeon.RimWorld.Biotech">
    <defName>BF_Firebreather</defName>
    <label>firebreather</label>
    <description>It can spit a stream of burning bile at anything that threatens it.</description>
    <rumor>breathes fire</rumor>
    <nameSuffix>the firebreather</nameSuffix>
    <rarity>Rare</rarity>
    <requiresFlesh>true</requiresFlesh>
    <tags><li>Fire</li></tags>
    <discoverWhen>
      <li>UsesGrantedAbility</li>
      <li>Dies</li>
    </discoverWhen>
    <abilities>
      <li>BF_FireBreath</li>
    </abilities>
  </BastleFramework.BastleTraitDef>

  <BastleFramework.BastleTraitDef>
    <defName>BF_Razorclawed</defName>
    <label>razorclawed</label>
    <description>Its natural weapons are sharper and heavier than they should be.</description>
    <rumor>strikes harder and cuts deeper than any other of its kind</rumor>
    <namePrefix>razorclawed</namePrefix>
    <scalesWithRarity>true</scalesWithRarity>
    <discoverWhen><li>Attacks</li></discoverWhen>
    <stage>
      <statFactors>
        <MeleeDamageFactor>1.2</MeleeDamageFactor>
      </statFactors>
    </stage>
  </BastleFramework.BastleTraitDef>

  <BastleFramework.BastleTraitDef>
    <defName>BF_Frenzied</defName>
    <label>frenzied</label>
    <description>It attacks in a wild flurry: faster, but less accurate.</description>
    <rumor>attacks in a wild flurry</rumor>
    <namePrefix>frenzied</namePrefix>
    <scalesWithRarity>true</scalesWithRarity>
    <discoverWhen><li>Attacks</li></discoverWhen>
    <stage>
      <statFactors>
        <MeleeCooldownFactor>0.84</MeleeCooldownFactor>
        <MeleeHitChance>0.94</MeleeHitChance>
      </statFactors>
    </stage>
  </BastleFramework.BastleTraitDef>

  <BastleFramework.BastleTraitDef>
    <defName>BF_Bonebreaker</defName>
    <label>bonebreaker</label>
    <description>It strikes with crushing force. A blow can leave the victim stunned.</description>
    <rumor>hits hard enough to leave its victims stunned</rumor>
    <nameSuffix>the bonebreaker</nameSuffix>
    <rarity>Rare</rarity>
    <exclusionTags><li>BF_Stun</li></exclusionTags>
    <discoverWhen>
      <li>UsesGrantedVerb</li>
      <li>Dies</li>
    </discoverWhen>
    <hediffs>
      <li><hediff>BF_BonebreakerBlow</hediff></li>
    </hediffs>
  </BastleFramework.BastleTraitDef>

  <!-- Visible: the blue glow and the arcs crackling over it give it away. Rolls Rare to
       Legendary; at Legendary it becomes thunderclap. -->
  <BastleFramework.BastleTraitDef>
    <defName>BF_Stormborn</defName>
    <label>stormborn</label>
    <description>Static crackles across its body. Its strikes carry an electric shock that interferes with technology.</description>
    <rumor>crackles with a shock that stops machines dead</rumor>
    <namePrefix>stormborn</namePrefix>
    <rarity>Rare</rarity>
    <scalesWithRarity>true</scalesWithRarity>
    <!-- Hidden: its looks hint at it (setting Looks hint at unknown traits) and leave which trait, and how strong, to discovery. -->
    <discoverWhen>
      <li>UsesGrantedVerb</li>
      <li>JoinsColony</li>
      <li>Dies</li>
    </discoverWhen>
    <exclusionTags><li>BF_Element</li></exclusionTags>
    <tags><li>Storm</li></tags>
    <overlays>
      <li>
        <color>(0.45, 0.7, 1.0, 0.22)</color>
        <pulseSpeed>2.2</pulseSpeed>
        <pulseMin>0.3</pulseMin>
      </li>
    </overlays>
    <surfaces>
      <li Class="BastleFramework.BastleSurface_Arcs">
        <count>2</count>
        <intervalTicks>30</intervalTicks>
        <chance>0.55</chance>
      </li>
    </surfaces>
    <glow>
      <radius>3.5</radius>
      <color>(110,170,255,0)</color>
    </glow>
    <hediffs>
      <li><hediff>BF_StormStrike</hediff></li>
    </hediffs>
    <rarityOverrides>
      <li>
        <minRarity>Legendary</minRarity>
        <label>thunderclap</label>
        <namePrefix>thunderclap</namePrefix>
        <description>Lightning crawls all over its body. Its strikes carry an electric shock that interferes with technology, and every so often a blow lands with a thunderclap that stuns its enemies nearby.</description>
        <rumor>strikes with a thunderclap that knocks everyone around its victim senseless</rumor>
        <surfaces>
          <li Class="BastleFramework.BastleSurface_Arcs">
            <count>4</count>
            <intervalTicks>20</intervalTicks>
            <chance>0.7</chance>
            <maxLength>0.65</maxLength>
          </li>
        </surfaces>
        <glow>
          <radius>5</radius>
          <color>(120,180,255,0)</color>
        </glow>
        <procs>
          <li>
            <on>Hit</on>
            <attack>Melee</attack>
            <chance>0.2</chance>
            <cooldownSeconds>8~12</cooldownSeconds>
            <radius>2.9</radius>
            <center>Other</center>
            <targets>Enemies</targets>
            <stunSeconds>2</stunSeconds>
            <mechanoidDamageDef>EMP</mechanoidDamageDef>
            <mechanoidDamage>15</mechanoidDamage>
            <fleck>LightningGlow</fleck>
            <fleckScale>4</fleckScale>
            <sound>Explosion_EMP</sound>
            <visuals>
              <li Class="BastleFramework.BastleVisual_Arcs"><at>Other</at><count>5~7</count><reach>0.6~1.3</reach><width>0.24</width><arcTicks>8</arcTicks><fleck>BF_Fleck_Static</fleck><fleckScale>0.14~0.22</fleckScale></li>
              <li Class="BastleFramework.BastleVisual_Arcs"><at>Other</at><to>Affected</to><segments>4</segments><jag>0.4</jag><width>0.26</width><arcTicks>12</arcTicks><fleck>BF_Fleck_Static</fleck></li>
            </visuals>
          </li>
        </procs>
      </li>
    </rarityOverrides>
  </BastleFramework.BastleTraitDef>

  <BastleFramework.BastleTraitDef>
    <defName>BF_Quilled</defName>
    <label>quilled</label>
    <description>It can flick a volley of barbed quills at its enemies.</description>
    <rumor>flings barbed quills from well out of reach</rumor>
    <namePrefix>quilled</namePrefix>
    <rarity>Rare</rarity>
    <requiresFlesh>true</requiresFlesh>
    <disallowConstructs>true</disallowConstructs>
    <discoverWhen>
      <li>UsesGrantedAbility</li>
      <li>Dies</li>
    </discoverWhen>
    <abilities>
      <li>BF_QuillVolley</li>
    </abilities>
  </BastleFramework.BastleTraitDef>

  <!-- Biotech only: uses vanilla's acid spray projectile and effect. -->
  <BastleFramework.BastleTraitDef MayRequire="Ludeon.RimWorld.Biotech">
    <defName>BF_AcidSpitting</defName>
    <label>acid-spitting</label>
    <description>It can spray sticky acid over an area, burning whatever it lands on.</description>
    <rumor>sprays acid that eats into whatever it lands on</rumor>
    <namePrefix>acid-spitting</namePrefix>
    <rarity>Rare</rarity>
    <requiresFlesh>true</requiresFlesh>
    <disallowConstructs>true</disallowConstructs>
    <discoverWhen>
      <li>UsesGrantedAbility</li>
      <li>Dies</li>
    </discoverWhen>
    <abilities>
      <li>BF_AcidSpit</li>
    </abilities>
  </BastleFramework.BastleTraitDef>

  <!-- Odyssey only: a copy of the terror roar, without the trainable requirement. -->
  <BastleFramework.BastleTraitDef MayRequire="Ludeon.RimWorld.Odyssey">
    <defName>BF_Dread</defName>
    <label>dread</label>
    <description>Its howl can send nearby enemies fleeing in terror.</description>
    <rumor>has a howl that sends people running in terror</rumor>
    <nameSuffix>of dread</nameSuffix>
    <rarity>Epic</rarity>
    <discoverWhen>
      <li>UsesGrantedAbility</li>
      <li>Dies</li>
    </discoverWhen>
    <abilities>
      <li>BF_DreadHowl</li>
    </abilities>
  </BastleFramework.BastleTraitDef>

  <BastleFramework.BastleTraitDef>
    <defName>BF_Leaping</defName>
    <label>leaping</label>
    <description>Its powerful legs let it leap onto its prey from a distance.</description>
    <rumor>leaps from far off to land on its prey</rumor>
    <namePrefix>leaping</namePrefix>
    <rarity>Uncommon</rarity>
    <discoverWhen>
      <li>UsesGrantedAbility</li>
      <li>Dies</li>
    </discoverWhen>
    <abilities><li>BF_Leap</li></abilities>
    <aiThinkTree>BF_LeapAtTarget</aiThinkTree>
  </BastleFramework.BastleTraitDef>

  <BastleFramework.BastleTraitDef>
    <defName>BF_Vampiric</defName>
    <label>vampiric</label>
    <description>Its wounds close as it feeds. Part of the damage it deals in melee to living flesh heals it.</description>
    <rumor>heals with every wound it inflicts</rumor>
    <namePrefix>vampiric</namePrefix>
    <scalesWithRarity>true</scalesWithRarity>
    <requiresFlesh>true</requiresFlesh>
    <disallowConstructs>true</disallowConstructs>
    <exclusionTags><li>BF_Healing</li></exclusionTags>
    <discoverWhen><li>Attacks</li></discoverWhen>
    <lifesteal>
      <fraction>0.17</fraction>
    </lifesteal>
    <!-- Red strands drawn out of whatever living thing it bites. -->
    <eventVisuals>
      <li Class="BastleFramework.BastleVisual_Ribbons">
        <on>Hit</on>
        <attack>Melee</attack>
        <otherFleshOnly>true</otherFleshOnly>
        <from>Other</from>
        <to>Self</to>
        <color>(0.85, 0.08, 0.1)</color>
        <strands>2~3</strands>
        <minIntervalTicks>90</minIntervalTicks>
      </li>
    </eventVisuals>
  </BastleFramework.BastleTraitDef>

  <!-- Cheap stat traits for the Common pool. -->
  <BastleFramework.BastleTraitDef>
    <defName>BF_HeavyHanded</defName>
    <label>heavy-handed</label>
    <description>It throws its whole weight behind every blow. It hits harder, but takes longer between attacks.</description>
    <rumor>throws its whole weight behind every blow</rumor>
    <namePrefix>heavy-handed</namePrefix>
    <scalesWithRarity>true</scalesWithRarity>
    <discoverWhen><li>Attacks</li></discoverWhen>
    <stage>
      <statFactors>
        <MeleeDamageFactor>1.18</MeleeDamageFactor>
        <MeleeCooldownFactor>1.06</MeleeCooldownFactor>
      </statFactors>
    </stage>
  </BastleFramework.BastleTraitDef>

  <BastleFramework.BastleTraitDef>
    <defName>BF_SureStriking</defName>
    <label>sure-striking</label>
    <description>It rarely misses.</description>
    <rumor>never seems to miss</rumor>
    <namePrefix>sure-striking</namePrefix>
    <scalesWithRarity>true</scalesWithRarity>
    <discoverWhen><li>Attacks</li></discoverWhen>
    <!-- MeleeHitChance is in skill levels before its curve (an animal's base is 4), so an
         offset is what moves it: the curve runs 50% at 0 to 80% at 10, so +4 takes an
         animal from about 62% to about 74%. -->
    <stage>
      <statOffsets>
        <MeleeHitChance>4</MeleeHitChance>
      </statOffsets>
    </stage>
  </BastleFramework.BastleTraitDef>

  <!-- Diet: turns any animal into a meat-eating hunter that won't touch plants.
       Hidden; revealed when a plant-eater eats meat, or starves beside plants. -->
  <BastleFramework.BastleTraitDef>
    <defName>BF_Bloodthirsty</defName>
    <label>bloodthirsty</label>
    <description>It has lost its taste for plants and hunts for meat instead.</description>
    <rumor>has a taste for flesh</rumor>
    <namePrefix>bloodthirsty</namePrefix>
    <requiresFlesh>true</requiresFlesh>
    <diet>
      <addFoodTypes>Meat, Corpse</addFoodTypes>
      <removeFoodTypes>VegetableOrFruit, Plant, Tree, Seed</removeFoodTypes>
      <hunts>true</hunts>
    </diet>
  </BastleFramework.BastleTraitDef>

  <!-- Dangerous in a dungeon, a liability as a pet. -->
  <BastleFramework.BastleTraitDef>
    <defName>BF_Volatile</defName>
    <label>volatile</label>
    <description>Something unstable builds inside it. When it dies, it explodes.</description>
    <rumor>explodes when it dies</rumor>
    <namePrefix>volatile</namePrefix>
    <rarity>Uncommon</rarity>
    <discoverWhen><li>Dies</li></discoverWhen>
    <hediffs>
      <li><hediff>BF_VolatileCore</hediff></li>
    </hediffs>
  </BastleFramework.BastleTraitDef>

</Defs>
