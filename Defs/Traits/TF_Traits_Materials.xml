<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Material traits: never rolled (commonality 0). A creature of the material
       always has them; see Patches/TF_Materials.xml. The material already shows in
       the name, so most of these have no name part of their own. -->

  <!-- Uranium. The faint green glow shows even before the trait is identified. -->
  <TitanFramework.TitanTraitDef>
    <defName>TF_Irradiated</defName>
    <label>irradiated</label>
    <description>Its uranium body poisons whatever it strikes.</description>
    <namePrefix>irradiated</namePrefix>
    <visible>true</visible>
    <commonality>0</commonality>
    <pointCost>0</pointCost>
    <heritable>false</heritable>
    <showVisualsWhenHidden>true</showVisualsWhenHidden>
    <discoverWhen>
      <li>UsesGrantedVerb</li>
      <li>Dies</li>
    </discoverWhen>
    <overlays>
      <li>
        <color>(0.4, 1.0, 0.3, 0.25)</color>
        <pulseSpeed>0.5</pulseSpeed>
        <pulseMin>0.3</pulseMin>
      </li>
    </overlays>
    <glow>
      <radius>3</radius>
      <color>(80,220,60,0)</color>
    </glow>
    <hediffs>
      <li><hediff>TF_IrradiatedTouch</hediff></li>
    </hediffs>
  </TitanFramework.TitanTraitDef>

  <!-- Gold. Worth a fortune, alive or as a statue. -->
  <TitanFramework.TitanTraitDef>
    <defName>TF_Gilded</defName>
    <label>gilded</label>
    <description>Its golden body is worth a fortune to any trader.</description>
    <visible>true</visible>
    <commonality>0</commonality>
    <pointCost>0</pointCost>
    <heritable>false</heritable>
    <marketValuePercent>1.0</marketValuePercent>
  </TitanFramework.TitanTraitDef>

  <!-- Plasteel. -->
  <TitanFramework.TitanTraitDef>
    <defName>TF_Unyielding</defName>
    <label>unyielding</label>
    <description>Its plasteel body can't be staggered, and every hit does less damage.</description>
    <visible>true</visible>
    <commonality>0</commonality>
    <pointCost>0</pointCost>
    <heritable>false</heritable>
    <stage>
      <statFactors>
        <StaggerDurationFactor>0</StaggerDurationFactor>
        <IncomingDamageFactor>0.85</IncomingDamageFactor>
      </statFactors>
    </stage>
  </TitanFramework.TitanTraitDef>

  <!-- Granite. -->
  <TitanFramework.TitanTraitDef>
    <defName>TF_Stonebound</defName>
    <label>stonebound</label>
    <description>Its granite body is slow and heavy, and blunt blows barely chip it.</description>
    <visible>true</visible>
    <commonality>0</commonality>
    <pointCost>0</pointCost>
    <heritable>false</heritable>
    <stage>
      <statFactors>
        <MoveSpeed>0.85</MoveSpeed>
      </statFactors>
      <damageFactors>
        <Blunt>0.6</Blunt>
      </damageFactors>
    </stage>
  </TitanFramework.TitanTraitDef>

  <!-- Bioferrite (Anomaly). -->
  <TitanFramework.TitanTraitDef MayRequire="Ludeon.RimWorld.Anomaly">
    <defName>TF_VoidTouched</defName>
    <label>void-touched</label>
    <description>Something dark moves under the surface of its bioferrite body. It is deaf to psychic effects.</description>
    <namePrefix>void-touched</namePrefix>
    <visible>true</visible>
    <commonality>0</commonality>
    <pointCost>0</pointCost>
    <heritable>false</heritable>
    <tags><li>Void</li></tags>
    <overlays>
      <li>
        <color>(0.35, 0.05, 0.1, 0.35)</color>
        <pulseSpeed>0.35</pulseSpeed>
        <pulseMin>0.2</pulseMin>
      </li>
    </overlays>
    <stage>
      <statFactors>
        <PsychicSensitivity>0</PsychicSensitivity>
      </statFactors>
    </stage>
  </TitanFramework.TitanTraitDef>

</Defs>
