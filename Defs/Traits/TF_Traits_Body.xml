<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Body and defence traits. Exclusion tags used across the suite:
       TF_Element      one elemental body (flaming, frostfur, stormborn)
       TF_FireAffinity one relationship with fire (flaming, emberborn, tinderhide)
       TF_Speed        swift / sluggish / lame
       TF_Toughness    shelled / stonehide / brittle-type traits
       TF_Healing      regenerating and similar
       TF_Hunger, TF_Rest  appetite and sleep, good or bad
       TF_Size         colossal / elder -->

  <!-- Visible: identified from the start, and in the name from the start. -->
  <TitanFramework.TitanTraitDef>
    <defName>TF_Flaming</defName>
    <label>flaming</label>
    <description>Its body burns without being consumed. Fire barely hurts it and it shrugs off the cold.</description>
    <visible>true</visible>
    <namePrefix>flaming</namePrefix>
    <rarity>Uncommon</rarity>
    <!-- Its fire resistance can't scale past Uncommon, so it rolls at Uncommon or,
         through the override, Legendary. -->
    <scalesWithRarity>true</scalesWithRarity>
    <exclusionTags>
      <li>TF_Element</li>
      <li>TF_FireAffinity</li>
    </exclusionTags>
    <tags><li>Fire</li></tags>
    <overlays>
      <li>
        <color>(1.0, 0.4, 0.05, 0.35)</color>
        <scale>1.0</scale>
        <layer>1</layer>
        <pulseSpeed>1.3</pulseSpeed>
        <pulseMin>0.5</pulseMin>
      </li>
    </overlays>
    <effecters>
      <li>TF_Effecter_Embers</li>
    </effecters>
    <glow>
      <radius>5</radius>
      <color>(240,130,50,0)</color>
    </glow>
    <stage>
      <statOffsets>
        <ComfyTemperatureMin>-40</ComfyTemperatureMin>
      </statOffsets>
      <damageFactors>
        <Flame>0.2</Flame>
        <Burn>0.2</Burn>
      </damageFactors>
    </stage>
    <rarityOverrides>
      <li>
        <minRarity>Legendary</minRarity>
        <label>infernal</label>
        <namePrefix>infernal</namePrefix>
        <description>Its body is a living blaze. Fire can't hurt it, and anything that strikes it in melee is burned and may catch fire.</description>
        <glow>
          <radius>8</radius>
          <color>(255,120,40,0)</color>
        </glow>
        <retaliation>
          <damageDef>Flame</damageDef>
          <amount>3</amount>
          <igniteChance>0.5</igniteChance>
        </retaliation>
        <stage>
          <statOffsets>
            <ComfyTemperatureMin>-60</ComfyTemperatureMin>
          </statOffsets>
          <damageFactors>
            <Flame>0</Flame>
            <Burn>0</Burn>
          </damageFactors>
        </stage>
      </li>
    </rarityOverrides>
  </TitanFramework.TitanTraitDef>

  <TitanFramework.TitanTraitDef>
    <defName>TF_Swift</defName>
    <label>swift</label>
    <description>It moves faster than others of its kind.</description>
    <namePrefix>swift</namePrefix>
    <scalesWithRarity>true</scalesWithRarity>
    <exclusionTags><li>TF_Speed</li></exclusionTags>
    <discoverWhen>
      <li>Attacks</li>
      <li>JoinsColony</li>
      <li>Dies</li>
    </discoverWhen>
    <stage>
      <statFactors>
        <MoveSpeed>1.15</MoveSpeed>
      </statFactors>
    </stage>
    <rarityOverrides>
      <li>
        <minRarity>Epic</minRarity>
        <description>It moves much faster than others of its kind, and can leap up to 10 tiles to land beside its prey.</description>
        <abilities><li>TF_Leap</li></abilities>
        <aiThinkTree>TF_LeapAtTarget</aiThinkTree>
      </li>
    </rarityOverrides>
  </TitanFramework.TitanTraitDef>

  <TitanFramework.TitanTraitDef>
    <defName>TF_Regenerating</defName>
    <label>regenerating</label>
    <description>Its wounds close with unnatural speed.</description>
    <namePrefix>regenerating</namePrefix>
    <rarity>Uncommon</rarity>
    <scalesWithRarity>true</scalesWithRarity>
    <!-- Regrows lost parts from Legendary up (RegrowthParams.minRarity). -->
    <traitClass>TitanFramework.TitanTrait_Regrowth</traitClass>
    <rarityOverrides>
      <li>
        <minRarity>Legendary</minRarity>
        <description>Its wounds close with unnatural speed, and lost limbs grow back, one every few hours.</description>
      </li>
    </rarityOverrides>
    <exclusionTags><li>TF_Healing</li></exclusionTags>
    <discoverWhen><li>TakesDamage</li></discoverWhen>
    <stage>
      <naturalHealingFactor>1.5</naturalHealingFactor>
      <regeneration>20</regeneration>
    </stage>
  </TitanFramework.TitanTraitDef>

  <TitanFramework.TitanTraitDef>
    <defName>TF_Emberborn</defName>
    <label>emberborn</label>
    <description>Fire cannot harm it, and it is at home in great heat.</description>
    <namePrefix>emberborn</namePrefix>
    <rarity>Uncommon</rarity>
    <exclusionTags><li>TF_FireAffinity</li></exclusionTags>
    <tags><li>Fire</li></tags>
    <discoverWhen><li>TakesDamage</li></discoverWhen>
    <stage>
      <statOffsets>
        <ComfyTemperatureMax>20</ComfyTemperatureMax>
      </statOffsets>
      <damageFactors>
        <Flame>0</Flame>
        <Burn>0</Burn>
      </damageFactors>
    </stage>
  </TitanFramework.TitanTraitDef>

  <TitanFramework.TitanTraitDef>
    <defName>TF_Unfeeling</defName>
    <label>unfeeling</label>
    <description>It feels no pain, and keeps fighting through wounds that would drop others.</description>
    <namePrefix>unfeeling</namePrefix>
    <rarity>Uncommon</rarity>
    <requiresFlesh>true</requiresFlesh>
    <disallowConstructs>true</disallowConstructs>
    <discoverWhen><li>TakesDamage</li></discoverWhen>
    <stage>
      <painFactor>0</painFactor>
    </stage>
  </TitanFramework.TitanTraitDef>

  <TitanFramework.TitanTraitDef>
    <defName>TF_Evasive</defName>
    <label>evasive</label>
    <description>It slips aside from blows that should land.</description>
    <namePrefix>phantom</namePrefix>
    <rarity>Uncommon</rarity>
    <scalesWithRarity>true</scalesWithRarity>
    <discoverWhen>
      <li>Attacks</li>
      <li>TakesDamage</li>
    </discoverWhen>
    <stage>
      <statOffsets>
        <MeleeDodgeChance>10</MeleeDodgeChance>
      </statOffsets>
    </stage>
  </TitanFramework.TitanTraitDef>

  <TitanFramework.TitanTraitDef>
    <defName>TF_Shelled</defName>
    <label>shelled</label>
    <description>A heavy shell covers its body. Blades skip off it, but the weight slows it down.</description>
    <namePrefix>shelled</namePrefix>
    <rarity>Rare</rarity>
    <disallowConstructs>true</disallowConstructs>
    <healthScaleFactor>1.2</healthScaleFactor>
    <exclusionTags><li>TF_Toughness</li></exclusionTags>
    <discoverWhen><li>TakesDamage</li></discoverWhen>
    <stage>
      <statOffsets>
        <ArmorRating_Sharp>0.6</ArmorRating_Sharp>
        <ArmorRating_Blunt>0.3</ArmorRating_Blunt>
      </statOffsets>
      <statFactors>
        <MoveSpeed>0.85</MoveSpeed>
      </statFactors>
    </stage>
  </TitanFramework.TitanTraitDef>

  <TitanFramework.TitanTraitDef>
    <defName>TF_ToxicBlooded</defName>
    <label>toxic-blooded</label>
    <description>Poison and toxic air barely affect it.</description>
    <namePrefix>toxic-blooded</namePrefix>
    <scalesWithRarity>true</scalesWithRarity>
    <requiresFlesh>true</requiresFlesh>
    <disallowConstructs>true</disallowConstructs>
    <discoverWhen>
      <li>TakesDamage</li>
      <li>JoinsColony</li>
    </discoverWhen>
    <stage>
      <statOffsets>
        <ToxicResistance>0.3</ToxicResistance>
        <ToxicEnvironmentResistance>0.3</ToxicEnvironmentResistance>
      </statOffsets>
    </stage>
  </TitanFramework.TitanTraitDef>

  <TitanFramework.TitanTraitDef>
    <defName>TF_Thorned</defName>
    <label>thorned</label>
    <description>Sharp barbs cover its body. Anything that strikes it in melee is cut.</description>
    <namePrefix>thorned</namePrefix>
    <rarity>Uncommon</rarity>
    <scalesWithRarity>true</scalesWithRarity>
    <discoverWhen><li>TakesDamage</li></discoverWhen>
    <retaliation>
      <damageDef>Stab</damageDef>
      <amount>4</amount>
      <armorPenetration>0.1</armorPenetration>
    </retaliation>
  </TitanFramework.TitanTraitDef>

  <!-- Visible: you can see the size. Not applied to humanlikes, which draw through a
       fixed-size render cache. -->
  <TitanFramework.TitanTraitDef>
    <defName>TF_Colossal</defName>
    <label>colossal</label>
    <description>It is far bigger than others of its kind: tougher and harder-hitting, but a little slower.</description>
    <namePrefix>colossal</namePrefix>
    <rarity>Rare</rarity>
    <visible>true</visible>
    <scalesWithRarity>true</scalesWithRarity>
    <allowHumanlikes>false</allowHumanlikes>
    <exclusionTags><li>TF_Size</li></exclusionTags>
    <drawSizeFactor>1.3</drawSizeFactor>
    <healthScaleFactor>1.25</healthScaleFactor>
    <stage>
      <statFactors>
        <MeleeDamageFactor>1.15</MeleeDamageFactor>
        <MoveSpeed>0.92</MoveSpeed>
      </statFactors>
    </stage>
  </TitanFramework.TitanTraitDef>

  <TitanFramework.TitanTraitDef>
    <defName>TF_Stonehide</defName>
    <label>stonehide</label>
    <description>Its hide is as dense as rock. Blunt blows barely bruise it.</description>
    <namePrefix>stonehide</namePrefix>
    <rarity>Uncommon</rarity>
    <scalesWithRarity>true</scalesWithRarity>
    <exclusionTags><li>TF_Toughness</li></exclusionTags>
    <discoverWhen><li>TakesDamage</li></discoverWhen>
    <stage>
      <damageFactors>
        <Blunt>0.7</Blunt>
      </damageFactors>
    </stage>
  </TitanFramework.TitanTraitDef>

</Defs>
