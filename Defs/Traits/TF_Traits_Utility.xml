<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Utility traits: mostly worth something once the creature is tamed. Most are
       revealed when it joins the colony, so taming an unknown titan is a gamble. -->

  <!-- Diet: lives on rock. Hidden; revealed by eating a chunk (diet default). -->
  <TitanFramework.TitanTraitDef>
    <defName>TF_Rockgut</defName>
    <label>rockgut</label>
    <description>It grinds stone in its gut and lives on it when there is nothing better.</description>
    <namePrefix>rockgut</namePrefix>
    <allowMechanoids>false</allowMechanoids>
    <tags><li>Utility</li></tags>
    <diet>
      <extraFoods>
        <li><thing>ChunkGranite</thing><nutrition>0.5</nutrition></li>
        <li><thing>ChunkLimestone</thing><nutrition>0.5</nutrition></li>
        <li><thing>ChunkMarble</thing><nutrition>0.5</nutrition></li>
        <li><thing>ChunkSandstone</thing><nutrition>0.5</nutrition></li>
        <li><thing>ChunkSlate</thing><nutrition>0.5</nutrition></li>
      </extraFoods>
    </diet>
  </TitanFramework.TitanTraitDef>

  <TitanFramework.TitanTraitDef>
    <defName>TF_Tireless</defName>
    <label>tireless</label>
    <description>It never sleeps, and never seems to tire.</description>
    <namePrefix>tireless</namePrefix>
    <rarity>Rare</rarity>
    <allowMechanoids>false</allowMechanoids>
    <exclusionTags><li>TF_Rest</li></exclusionTags>
    <tags><li>Utility</li></tags>
    <discoverWhen>
      <li>JoinsColony</li>
      <li>Dies</li>
    </discoverWhen>
    <stage>
      <disablesNeeds><li>Rest</li></disablesNeeds>
    </stage>
  </TitanFramework.TitanTraitDef>

  <TitanFramework.TitanTraitDef>
    <defName>TF_Frugal</defName>
    <label>frugal</label>
    <description>It needs far less food than others of its kind.</description>
    <namePrefix>frugal</namePrefix>
    <scalesWithRarity>true</scalesWithRarity>
    <allowMechanoids>false</allowMechanoids>
    <exclusionTags><li>TF_Hunger</li></exclusionTags>
    <tags><li>Utility</li></tags>
    <discoverWhen>
      <li>JoinsColony</li>
      <li>Dies</li>
    </discoverWhen>
    <stage>
      <hungerRateFactor>0.75</hungerRateFactor>
    </stage>
  </TitanFramework.TitanTraitDef>

  <TitanFramework.TitanTraitDef>
    <defName>TF_Meaty</defName>
    <label>meaty</label>
    <description>Thick muscle and fat. It gives much more meat when butchered.</description>
    <namePrefix>meaty</namePrefix>
    <scalesWithRarity>true</scalesWithRarity>
    <requiresFlesh>true</requiresFlesh>
    <disallowConstructs>true</disallowConstructs>
    <tags><li>Utility</li></tags>
    <discoverWhen>
      <li>JoinsColony</li>
      <li>Dies</li>
    </discoverWhen>
    <stage>
      <statFactors>
        <MeatAmount>1.3</MeatAmount>
      </statFactors>
    </stage>
  </TitanFramework.TitanTraitDef>

  <TitanFramework.TitanTraitDef>
    <defName>TF_FineHided</defName>
    <label>fine-hided</label>
    <description>A broad, flawless hide. It gives much more leather when butchered.</description>
    <namePrefix>fine-hided</namePrefix>
    <scalesWithRarity>true</scalesWithRarity>
    <requiresFlesh>true</requiresFlesh>
    <disallowConstructs>true</disallowConstructs>
    <tags><li>Utility</li></tags>
    <discoverWhen>
      <li>JoinsColony</li>
      <li>Dies</li>
    </discoverWhen>
    <stage>
      <statFactors>
        <LeatherAmount>1.3</LeatherAmount>
      </statFactors>
    </stage>
  </TitanFramework.TitanTraitDef>

  <TitanFramework.TitanTraitDef>
    <defName>TF_Packbeast</defName>
    <label>packbeast</label>
    <description>A broad back and strong legs. It can haul and carry far more than others of its kind.</description>
    <namePrefix>packbeast</namePrefix>
    <scalesWithRarity>true</scalesWithRarity>
    <tags><li>Utility</li></tags>
    <discoverWhen>
      <li>JoinsColony</li>
      <li>Dies</li>
    </discoverWhen>
    <stage>
      <statFactors>
        <CarryingCapacity>1.3</CarryingCapacity>
      </statFactors>
    </stage>
  </TitanFramework.TitanTraitDef>

  <!-- Cosmetic light. Cheap, since it does nothing else. -->
  <TitanFramework.TitanTraitDef>
    <defName>TF_Luminous</defName>
    <label>luminous</label>
    <description>It gives off a soft, steady light, enough to light a room.</description>
    <namePrefix>luminous</namePrefix>
    <visible>true</visible>
    <pointCost>0.5</pointCost>
    <tags><li>Utility</li></tags>
    <overlays>
      <li>
        <color>(1.0, 0.95, 0.75, 0.2)</color>
        <pulseSpeed>0.4</pulseSpeed>
        <pulseMin>0.7</pulseMin>
      </li>
    </overlays>
    <glow>
      <radius>6</radius>
      <color>(255,240,200,0)</color>
    </glow>
  </TitanFramework.TitanTraitDef>

</Defs>
