<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Drawbacks: negative points give budget back and only roll through the
       drawback chance in the mod settings. -->

  <BastleFramework.BastleTraitDef>
    <defName>BF_Brittle</defName>
    <label>brittle</label>
    <description>Something about it is fragile. It takes more damage from every hit.</description>
    <namePrefix>brittle</namePrefix>
    <nameOrder>-10</nameOrder>
    <pointCost>-1</pointCost>
    <commonality>0.5</commonality>
    <scalesWithRarity>true</scalesWithRarity>
    <exclusionTags><li>BF_Toughness</li></exclusionTags>
    <discoverWhen><li>TakesDamage</li></discoverWhen>
    <stage>
      <statFactors>
        <IncomingDamageFactor>1.3</IncomingDamageFactor>
      </statFactors>
    </stage>
  </BastleFramework.BastleTraitDef>

  <BastleFramework.BastleTraitDef>
    <defName>BF_Tinderhide</defName>
    <label>tinderhide</label>
    <description>Its body catches fire easily. It takes double damage from flames.</description>
    <namePrefix>tinderhide</namePrefix>
    <nameOrder>-10</nameOrder>
    <pointCost>-1</pointCost>
    <exclusionTags><li>BF_FireAffinity</li></exclusionTags>
    <discoverWhen><li>TakesDamage</li></discoverWhen>
    <stage>
      <damageFactors>
        <Flame>2</Flame>
        <Burn>2</Burn>
      </damageFactors>
    </stage>
  </BastleFramework.BastleTraitDef>

  <BastleFramework.BastleTraitDef>
    <defName>BF_Sluggish</defName>
    <label>sluggish</label>
    <description>It moves slowly, even for its kind.</description>
    <namePrefix>sluggish</namePrefix>
    <nameOrder>-10</nameOrder>
    <pointCost>-1</pointCost>
    <exclusionTags><li>BF_Speed</li></exclusionTags>
    <discoverWhen>
      <li>Attacks</li>
      <li>JoinsColony</li>
      <li>Dies</li>
    </discoverWhen>
    <stage>
      <statFactors>
        <MoveSpeed>0.8</MoveSpeed>
      </statFactors>
    </stage>
  </BastleFramework.BastleTraitDef>

  <BastleFramework.BastleTraitDef>
    <defName>BF_Ravenous</defName>
    <label>ravenous</label>
    <description>It is always hungry, and eats far more than others of its kind.</description>
    <namePrefix>ravenous</namePrefix>
    <nameOrder>-10</nameOrder>
    <pointCost>-1</pointCost>
    <allowMechanoids>false</allowMechanoids>
    <exclusionTags><li>BF_Hunger</li></exclusionTags>
    <tags><li>Utility</li></tags>
    <discoverWhen>
      <li>JoinsColony</li>
      <li>Dies</li>
    </discoverWhen>
    <stage>
      <hungerRateFactor>1.6</hungerRateFactor>
    </stage>
  </BastleFramework.BastleTraitDef>

  <BastleFramework.BastleTraitDef>
    <defName>BF_Sickly</defName>
    <label>sickly</label>
    <description>Its body fights off disease slowly.</description>
    <namePrefix>sickly</namePrefix>
    <nameOrder>-10</nameOrder>
    <pointCost>-1</pointCost>
    <requiresFlesh>true</requiresFlesh>
    <disallowConstructs>true</disallowConstructs>
    <tags><li>Utility</li></tags>
    <discoverWhen>
      <li>JoinsColony</li>
      <li>Dies</li>
    </discoverWhen>
    <stage>
      <statFactors>
        <ImmunityGainSpeed>0.7</ImmunityGainSpeed>
      </statFactors>
    </stage>
  </BastleFramework.BastleTraitDef>

  <BastleFramework.BastleTraitDef>
    <defName>BF_CloudedEyes</defName>
    <label>clouded eyes</label>
    <description>A milky film covers its eyes. It sees poorly.</description>
    <namePrefix>cloudy-eyed</namePrefix>
    <nameOrder>-10</nameOrder>
    <pointCost>-1</pointCost>
    <requiresFlesh>true</requiresFlesh>
    <exclusionTags><li>BF_Sight</li></exclusionTags>
    <discoverWhen>
      <li>Attacks</li>
      <li>JoinsColony</li>
    </discoverWhen>
    <stage>
      <capMods>
        <li>
          <capacity>Sight</capacity>
          <offset>-0.3</offset>
        </li>
      </capMods>
    </stage>
  </BastleFramework.BastleTraitDef>

  <BastleFramework.BastleTraitDef>
    <defName>BF_Lame</defName>
    <label>lame</label>
    <description>An old injury that never healed right. It limps.</description>
    <namePrefix>lame</namePrefix>
    <nameOrder>-10</nameOrder>
    <pointCost>-1</pointCost>
    <requiresFlesh>true</requiresFlesh>
    <exclusionTags><li>BF_Speed</li></exclusionTags>
    <discoverWhen>
      <li>Attacks</li>
      <li>JoinsColony</li>
    </discoverWhen>
    <stage>
      <capMods>
        <li>
          <capacity>Moving</capacity>
          <offset>-0.2</offset>
        </li>
      </capMods>
    </stage>
  </BastleFramework.BastleTraitDef>

  <BastleFramework.BastleTraitDef>
    <defName>BF_Bleeder</defName>
    <label>bleeder</label>
    <description>Its blood doesn't clot well. Wounds bleed twice as fast.</description>
    <namePrefix>thin-blooded</namePrefix>
    <nameOrder>-10</nameOrder>
    <pointCost>-1</pointCost>
    <requiresFlesh>true</requiresFlesh>
    <disallowConstructs>true</disallowConstructs>
    <exclusionTags><li>BF_Blood</li></exclusionTags>
    <discoverWhen><li>TakesDamage</li></discoverWhen>
    <stage>
      <totalBleedFactor>2</totalBleedFactor>
    </stage>
  </BastleFramework.BastleTraitDef>

  <BastleFramework.BastleTraitDef>
    <defName>BF_Restless</defName>
    <label>restless</label>
    <description>It sleeps badly and tires quickly.</description>
    <namePrefix>restless</namePrefix>
    <nameOrder>-10</nameOrder>
    <pointCost>-1</pointCost>
    <allowMechanoids>false</allowMechanoids>
    <exclusionTags><li>BF_Rest</li></exclusionTags>
    <tags><li>Utility</li></tags>
    <discoverWhen>
      <li>JoinsColony</li>
      <li>Dies</li>
    </discoverWhen>
    <stage>
      <restFallFactor>1.5</restFallFactor>
    </stage>
  </BastleFramework.BastleTraitDef>

  <!-- Its stage only applies while it stands in light (BastleTrait_Lightsick). -->
  <BastleFramework.BastleTraitDef>
    <defName>BF_Lightsick</defName>
    <label>lightsick</label>
    <description>It is a creature of the dark. In bright light it squints, stumbles and fights poorly.</description>
    <namePrefix>lightsick</namePrefix>
    <nameOrder>-10</nameOrder>
    <pointCost>-1</pointCost>
    <traitClass>BastleFramework.BastleTrait_Lightsick</traitClass>
    <requiresFlesh>true</requiresFlesh>
    <exclusionTags><li>BF_Sight</li></exclusionTags>
    <discoverWhen>
      <li>Attacks</li>
      <li>JoinsColony</li>
    </discoverWhen>
    <stage>
      <capMods>
        <li>
          <capacity>Sight</capacity>
          <offset>-0.3</offset>
        </li>
      </capMods>
      <statFactors>
        <MoveSpeed>0.85</MoveSpeed>
        <MeleeHitChance>0.85</MeleeHitChance>
      </statFactors>
    </stage>
  </BastleFramework.BastleTraitDef>

  <!-- Can't breed, so it can't pass this on either. -->
  <BastleFramework.BastleTraitDef>
    <defName>BF_Barren</defName>
    <label>barren</label>
    <description>It cannot have offspring.</description>
    <namePrefix>barren</namePrefix>
    <nameOrder>-10</nameOrder>
    <pointCost>-0.5</pointCost>
    <heritable>false</heritable>
    <requiresFlesh>true</requiresFlesh>
    <allowHumanlikes>false</allowHumanlikes>
    <tags><li>Utility</li></tags>
    <discoverWhen>
      <li>JoinsColony</li>
      <li>Dies</li>
    </discoverWhen>
    <hediffs>
      <li><hediff>BF_BarrenBody</hediff></li>
    </hediffs>
  </BastleFramework.BastleTraitDef>

  <!-- Diet drawback: a tamed one eats steel from your stockpile. Revealed by eating it. -->
  <BastleFramework.BastleTraitDef>
    <defName>BF_MetalHungry</defName>
    <label>metal-hungry</label>
    <description>It craves metal and will chew through a stockpile of steel when it gets hungry.</description>
    <namePrefix>metal-hungry</namePrefix>
    <nameOrder>-10</nameOrder>
    <pointCost>-1</pointCost>
    <allowMechanoids>false</allowMechanoids>
    <tags><li>Utility</li></tags>
    <diet>
      <extraFoods>
        <li><thing>Steel</thing><nutrition>0.05</nutrition></li>
      </extraFoods>
    </diet>
  </BastleFramework.BastleTraitDef>

  <BastleFramework.BastleTraitDef>
    <defName>BF_HeatIntolerant</defName>
    <label>heat-intolerant</label>
    <description>It suffers in the heat. Its comfortable temperature range tops out 15 degrees lower than its kind's.</description>
    <namePrefix>heat-sick</namePrefix>
    <nameOrder>-10</nameOrder>
    <pointCost>-1</pointCost>
    <allowMechanoids>false</allowMechanoids>
    <!-- Humans are comfortable over only 10 degrees, so -15 would turn the range inside out. -->
    <allowHumanlikes>false</allowHumanlikes>
    <exclusionTags><li>BF_HeatTolerance</li><li>BF_TempDrawback</li></exclusionTags>
    <tags><li>Utility</li></tags>
    <discoverWhen>
      <li>JoinsColony</li>
      <li>Dies</li>
    </discoverWhen>
    <stage>
      <statOffsets>
        <ComfyTemperatureMax>-15</ComfyTemperatureMax>
      </statOffsets>
    </stage>
  </BastleFramework.BastleTraitDef>

  <BastleFramework.BastleTraitDef>
    <defName>BF_ChillProne</defName>
    <label>chill-prone</label>
    <description>It feels the cold badly. Its comfortable temperature range starts 15 degrees higher than its kind's.</description>
    <namePrefix>shivering</namePrefix>
    <nameOrder>-10</nameOrder>
    <pointCost>-1</pointCost>
    <allowMechanoids>false</allowMechanoids>
    <allowHumanlikes>false</allowHumanlikes>
    <exclusionTags><li>BF_ColdTolerance</li><li>BF_TempDrawback</li></exclusionTags>
    <tags><li>Utility</li></tags>
    <discoverWhen>
      <li>JoinsColony</li>
      <li>Dies</li>
    </discoverWhen>
    <stage>
      <statOffsets>
        <ComfyTemperatureMin>15</ComfyTemperatureMin>
      </statOffsets>
    </stage>
  </BastleFramework.BastleTraitDef>

  <!-- An aura that only reaches sleepers. No ground glow: a drawback shouldn't shine. -->
  <BastleFramework.BastleTraitDef>
    <defName>BF_Noisy</defName>
    <label>noisy</label>
    <description>It grunts, scratches and paces through the night. Anyone asleep within 6 tiles of it rests 30% less well, unless a wall is in the way.</description>
    <namePrefix>noisy</namePrefix>
    <nameOrder>-10</nameOrder>
    <pointCost>-1</pointCost>
    <traitClass>BastleFramework.BastleTrait_Aura</traitClass>
    <allowMechanoids>false</allowMechanoids>
    <tags><li>Utility</li></tags>
    <discoverWhen>
      <li>JoinsColony</li>
      <li>Dies</li>
    </discoverWhen>
    <modExtensions>
      <li Class="BastleFramework.AuraParams">
        <radius>5.9</radius>
        <intervalTicks>120</intervalTicks>
        <hediff>BF_Disturbed</hediff>
        <affectsAllies>true</affectsAllies>
        <affectsNeutrals>true</affectsNeutrals>
        <affectsEnemies>true</affectsEnemies>
        <targetsAsleepOnly>true</targetsAsleepOnly>
        <showGlow>false</showGlow>
        <ringColor>(0.7, 0.7, 0.7, 1)</ringColor>
      </li>
    </modExtensions>
  </BastleFramework.BastleTraitDef>

  <BastleFramework.BastleTraitDef>
    <defName>BF_Shedding</defName>
    <label>shedding</label>
    <description>It sheds constantly, leaving a clump of fur wherever it stands every few hours.</description>
    <namePrefix>shedding</namePrefix>
    <nameOrder>-10</nameOrder>
    <pointCost>-0.5</pointCost>
    <traitClass>BastleFramework.BastleTrait_Shedding</traitClass>
    <requiresFlesh>true</requiresFlesh>
    <disallowConstructs>true</disallowConstructs>
    <allowHumanlikes>false</allowHumanlikes>
    <tags><li>Utility</li></tags>
    <discoverWhen>
      <li>JoinsColony</li>
      <li>Dies</li>
    </discoverWhen>
  </BastleFramework.BastleTraitDef>

  <!-- Heats a room like a small heater (a third of one), up to 35 degrees. A boon in winter. -->
  <BastleFramework.BastleTraitDef>
    <defName>BF_Sweltering</defName>
    <label>sweltering</label>
    <description>Heat pours off its body. Indoors it warms the room like a small heater, up to 35 degrees: welcome in winter, stifling in summer.</description>
    <namePrefix>sweltering</namePrefix>
    <nameOrder>-10</nameOrder>
    <pointCost>-0.5</pointCost>
    <traitClass>BastleFramework.BastleTrait_Sweltering</traitClass>
    <allowMechanoids>false</allowMechanoids>
    <tags>
      <li>Utility</li>
      <li>Heat</li>
    </tags>
    <discoverWhen>
      <li>JoinsColony</li>
      <li>Dies</li>
    </discoverWhen>
    <!-- A faint warm shimmer rising off it. -->
    <surfaces>
      <li Class="BastleFramework.BastleSurface_Flow">
        <color>(1, 0.7, 0.45, 0.14)</color>
        <coreColor>(1, 0.85, 0.65, 1)</coreColor>
        <threshold>0.55</threshold>
        <coreThreshold>0.9</coreThreshold>
        <loopTicks>240</loopTicks>
        <scrolls>2</scrolls>
        <frames>32</frames>
        <cellsAcross>10</cellsAcross>
        <cellsUp>5</cellsUp>
      </li>
    </surfaces>
  </BastleFramework.BastleTraitDef>

</Defs>
