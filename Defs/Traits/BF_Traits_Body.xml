<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Body and defence traits. Exclusion tags used across the suite:
       BF_Element      one elemental body (flaming, frostfur in Utility, stormborn)
       BF_FireAffinity one relationship with fire (flaming, emberborn, tinderhide)
       BF_Speed        swift / sluggish / lame
       BF_Toughness    shelled / stonehide / brittle-type traits
       BF_Healing      regenerating and similar
       BF_Hunger, BF_Rest  appetite and sleep, good or bad
       BF_Size         colossal / elder -->

  <!-- Visible: identified from the start, and in the name from the start. -->
  <BastleFramework.BastleTraitDef>
    <defName>BF_Flaming</defName>
    <label>flaming</label>
    <description>Its body burns without being consumed. Fire barely hurts it and it shrugs off the cold.</description>
    <rumor>is covered in flames that don't consume it</rumor>
    <!-- Hidden: its looks hint at it (setting Looks hint at unknown traits) and leave which trait, and how strong, to discovery. -->
    <discoverWhen>
      <li>TakesDamage</li>
      <li>JoinsColony</li>
      <li>Dies</li>
    </discoverWhen>
    <namePrefix>flaming</namePrefix>
    <rarity>Uncommon</rarity>
    <!-- Its fire resistance can't scale past Uncommon, so it rolls at Uncommon or,
         through the override, Legendary. -->
    <scalesWithRarity>true</scalesWithRarity>
    <exclusionTags>
      <li>BF_Element</li>
      <li>BF_FireAffinity</li>
      <li>BF_ColdTolerance</li>
      <li>BF_HeatTolerance</li>
    </exclusionTags>
    <tags><li>Fire</li></tags>
    <!-- A steady orange glow over the whole body, with flames crawling up it on top and
         licking a little above its outline (riseAbove, a fraction of the texture height). -->
    <overlays>
      <li>
        <color>(1.0, 0.4, 0.05, 0.25)</color>
        <scale>1.0</scale>
        <layer>1</layer>
        <pulseSpeed>1.3</pulseSpeed>
        <pulseMin>0.5</pulseMin>
      </li>
    </overlays>
    <surfaces>
      <li Class="BastleFramework.BastleSurface_Flow">
        <color>(1, 0.45, 0.08, 0.5)</color>
        <threshold>0.5</threshold>
        <coreThreshold>0.78</coreThreshold>
        <loopTicks>360</loopTicks>
        <frames>32</frames>
        <riseAbove>0.1</riseAbove>
      </li>
    </surfaces>
    <effecters>
      <li>BF_Effecter_Embers</li>
    </effecters>
    <glow>
      <radius>5</radius>
      <color>(240,130,50,0)</color>
    </glow>
    <stage>
      <statOffsets>
        <ComfyTemperatureMin>-40</ComfyTemperatureMin>
      </statOffsets>
      <damageFactors>
        <Flame>0.2</Flame>
        <Burn>0.2</Burn>
      </damageFactors>
    </stage>
    <rarityOverrides>
      <li>
        <minRarity>Legendary</minRarity>
        <label>infernal</label>
        <namePrefix>infernal</namePrefix>
        <description>Its body is a living blaze. Fire can't hurt it, and its flames leap to those who hit it.</description>
        <rumor>is a living blaze that sets alight whatever strikes it</rumor>
        <glow>
          <radius>8</radius>
          <color>(255,120,40,0)</color>
        </glow>
        <overlays>
          <li>
            <color>(1.0, 0.35, 0.05, 0.35)</color>
            <scale>1.0</scale>
            <layer>1</layer>
            <pulseSpeed>1.5</pulseSpeed>
            <pulseMin>0.5</pulseMin>
          </li>
        </overlays>
        <!-- Faster, denser flames than flaming: more of the noise shows, it rises three
             times a loop (so more frames keep the step small), and it pulses. -->
        <surfaces>
          <li Class="BastleFramework.BastleSurface_Flow">
            <color>(1, 0.4, 0.05, 0.8)</color>
            <threshold>0.4</threshold>
            <coreThreshold>0.7</coreThreshold>
            <loopTicks>300</loopTicks>
            <scrolls>3</scrolls>
            <frames>48</frames>
            <evolveCells>4</evolveCells>
            <pulseSpeed>0.7</pulseSpeed>
            <pulseMin>0.75</pulseMin>
            <riseAbove>0.16</riseAbove>
          </li>
        </surfaces>
        <retaliation>
          <damageDef>Flame</damageDef>
          <amount>3</amount>
          <igniteChance>0.5</igniteChance>
        </retaliation>
        <stage>
          <statOffsets>
            <ComfyTemperatureMin>-60</ComfyTemperatureMin>
          </statOffsets>
          <damageFactors>
            <Flame>0</Flame>
            <Burn>0</Burn>
          </damageFactors>
        </stage>
      </li>
    </rarityOverrides>
  </BastleFramework.BastleTraitDef>

  <BastleFramework.BastleTraitDef>
    <defName>BF_Swift</defName>
    <label>swift</label>
    <description>It moves faster than others of its kind.</description>
    <rumor>runs down anything that tries to flee</rumor>
    <namePrefix>swift</namePrefix>
    <scalesWithRarity>true</scalesWithRarity>
    <exclusionTags><li>BF_Speed</li></exclusionTags>
    <discoverWhen>
      <li>Attacks</li>
      <li>JoinsColony</li>
      <li>Dies</li>
    </discoverWhen>
    <stage>
      <statFactors>
        <MoveSpeed>1.15</MoveSpeed>
      </statFactors>
    </stage>
    <rarityOverrides>
      <li>
        <minRarity>Epic</minRarity>
        <description>It moves much faster than others of its kind, and can leap up onto its prey from a distance.</description>
        <rumor>runs down anything that flees, and leaps on its prey from far off</rumor>
        <abilities><li>BF_Leap</li></abilities>
        <aiThinkTree>BF_LeapAtTarget</aiThinkTree>
        <!-- Faded copies left behind as it runs. -->
        <afterimages>
          <intervalTicks>5</intervalTicks>
          <lifeTicks>22</lifeTicks>
          <color>(1, 0.85, 0.55, 0.45)</color>
        </afterimages>
      </li>
    </rarityOverrides>
  </BastleFramework.BastleTraitDef>

  <BastleFramework.BastleTraitDef>
    <defName>BF_Regenerating</defName>
    <label>regenerating</label>
    <description>Its wounds close with unnatural speed.</description>
    <rumor>heals as soon as it is wounded</rumor>
    <namePrefix>regenerating</namePrefix>
    <scalesWithRarity>true</scalesWithRarity>
    <!-- Regrows lost parts from Legendary up (RegrowthParams.minRarity). -->
    <traitClass>BastleFramework.BastleTrait_Regrowth</traitClass>
    <rarityOverrides>
      <li>
        <minRarity>Legendary</minRarity>
        <description>Its wounds close with unnatural speed, and lost limbs grow back.</description>
        <rumor>regrows the limbs it loses</rumor>
      </li>
    </rarityOverrides>
    <exclusionTags><li>BF_Healing</li></exclusionTags>
    <discoverWhen><li>TakesDamage</li></discoverWhen>
    <stage>
      <naturalHealingFactor>1.4</naturalHealingFactor>
      <regeneration>16</regeneration>
    </stage>
    <!-- A soft green pulse as its wounds close, every few seconds at most. -->
    <eventVisuals>
      <li Class="BastleFramework.BastleVisual_Flecks">
        <on>Heal</on>
        <fleck>BF_Fleck_HealGlow</fleck>
        <scale>0.9~1.2</scale>
        <minIntervalTicks>180</minIntervalTicks>
      </li>
    </eventVisuals>
  </BastleFramework.BastleTraitDef>

  <BastleFramework.BastleTraitDef>
    <defName>BF_Emberborn</defName>
    <label>emberborn</label>
    <description>Fire cannot harm it, and it is at home in great heat.</description>
    <rumor>walks through fire without a mark</rumor>
    <namePrefix>emberborn</namePrefix>
    <rarity>Uncommon</rarity>
    <exclusionTags>
      <li>BF_FireAffinity</li>
      <li>BF_HeatTolerance</li>
    </exclusionTags>
    <tags><li>Fire</li></tags>
    <discoverWhen><li>TakesDamage</li></discoverWhen>
    <stage>
      <statOffsets>
        <ComfyTemperatureMax>20</ComfyTemperatureMax>
      </statOffsets>
      <damageFactors>
        <Flame>0</Flame>
        <Burn>0</Burn>
      </damageFactors>
    </stage>
  </BastleFramework.BastleTraitDef>

  <BastleFramework.BastleTraitDef>
    <defName>BF_Unfeeling</defName>
    <label>unfeeling</label>
    <description>It feels no pain, and keeps fighting through wounds that would drop others.</description>
    <rumor>keeps fighting through wounds that should have dropped it</rumor>
    <namePrefix>unfeeling</namePrefix>
    <rarity>Uncommon</rarity>
    <requiresFlesh>true</requiresFlesh>
    <disallowConstructs>true</disallowConstructs>
    <discoverWhen><li>TakesDamage</li></discoverWhen>
    <stage>
      <painFactor>0</painFactor>
    </stage>
  </BastleFramework.BastleTraitDef>

  <BastleFramework.BastleTraitDef>
    <defName>BF_Evasive</defName>
    <label>evasive</label>
    <description>It slips aside from blows that should land.</description>
    <rumor>slips aside from blows that should have landed</rumor>
    <namePrefix>phantom</namePrefix>
    <scalesWithRarity>true</scalesWithRarity>
    <discoverWhen>
      <li>Dodges</li>
    </discoverWhen>
    <stage>
      <statOffsets>
        <MeleeDodgeChance>8</MeleeDodgeChance>
      </statOffsets>
    </stage>
    <!-- The blow passes through an image of it sliding aside. -->
    <eventVisuals>
      <li Class="BastleFramework.BastleVisual_Afterimage">
        <on>Dodge</on>
      </li>
    </eventVisuals>
  </BastleFramework.BastleTraitDef>

  <BastleFramework.BastleTraitDef>
    <defName>BF_Shelled</defName>
    <label>shelled</label>
    <description>A heavy shell covers its body. Blades skip off it, but the weight slows it down.</description>
    <rumor>wears a shell that blades skip off</rumor>
    <namePrefix>shelled</namePrefix>
    <scalesWithRarity>true</scalesWithRarity>
    <disallowConstructs>true</disallowConstructs>
    <healthScaleFactor>1.1</healthScaleFactor>
    <exclusionTags><li>BF_Toughness</li></exclusionTags>
    <discoverWhen><li>TakesDamage</li></discoverWhen>
    <stage>
      <statOffsets>
        <ArmorRating_Sharp>0.3</ArmorRating_Sharp>
        <ArmorRating_Blunt>0.15</ArmorRating_Blunt>
      </statOffsets>
      <statFactors>
        <MoveSpeed>0.92</MoveSpeed>
      </statFactors>
    </stage>
  </BastleFramework.BastleTraitDef>

  <BastleFramework.BastleTraitDef>
    <defName>BF_ToxicBlooded</defName>
    <label>toxic-blooded</label>
    <description>Poison and toxic air barely affect it.</description>
    <rumor>breathes poisoned air without harm</rumor>
    <namePrefix>toxic-blooded</namePrefix>
    <scalesWithRarity>true</scalesWithRarity>
    <requiresFlesh>true</requiresFlesh>
    <disallowConstructs>true</disallowConstructs>
    <discoverWhen>
      <li>TakesDamage</li>
      <li>JoinsColony</li>
    </discoverWhen>
    <stage>
      <statOffsets>
        <ToxicResistance>0.3</ToxicResistance>
        <ToxicEnvironmentResistance>0.3</ToxicEnvironmentResistance>
      </statOffsets>
    </stage>
  </BastleFramework.BastleTraitDef>

  <BastleFramework.BastleTraitDef>
    <defName>BF_Thorned</defName>
    <label>thorned</label>
    <description>Sharp barbs cover its body. Anything that strikes it in melee is cut.</description>
    <rumor>is covered in barbs that cut anyone who strikes it</rumor>
    <namePrefix>thorned</namePrefix>
    <scalesWithRarity>true</scalesWithRarity>
    <discoverWhen><li>TakesDamage</li></discoverWhen>
    <retaliation>
      <damageDef>Stab</damageDef>
      <amount>3</amount>
      <armorPenetration>0.1</armorPenetration>
    </retaliation>
  </BastleFramework.BastleTraitDef>

  <!-- Visible: you can see the size. Not applied to humanlikes, which draw through a
       fixed-size render cache. -->
  <BastleFramework.BastleTraitDef>
    <defName>BF_Colossal</defName>
    <label>colossal</label>
    <description>It is far bigger than others of its kind: tougher and harder-hitting, but a little slower.</description>
    <rumor>towers over the rest of its kind</rumor>
    <namePrefix>colossal</namePrefix>
    <rarity>Rare</rarity>
    <visible>true</visible>
    <scalesWithRarity>true</scalesWithRarity>
    <allowHumanlikes>false</allowHumanlikes>
    <exclusionTags><li>BF_Size</li></exclusionTags>
    <drawSizeFactor>1.3</drawSizeFactor>
    <healthScaleFactor>1.25</healthScaleFactor>
    <stage>
      <statFactors>
        <MeleeDamageFactor>1.15</MeleeDamageFactor>
        <MoveSpeed>0.92</MoveSpeed>
      </statFactors>
    </stage>
  </BastleFramework.BastleTraitDef>

  <BastleFramework.BastleTraitDef>
    <defName>BF_Stonehide</defName>
    <label>stonehide</label>
    <description>Its hide is as dense as rock. Blunt blows barely bruise it.</description>
    <rumor>has a hide like rock that clubs barely bruise</rumor>
    <namePrefix>stonehide</namePrefix>
    <scalesWithRarity>true</scalesWithRarity>
    <exclusionTags><li>BF_Toughness</li></exclusionTags>
    <discoverWhen><li>TakesDamage</li></discoverWhen>
    <stage>
      <damageFactors>
        <Blunt>0.76</Blunt>
      </damageFactors>
    </stage>
  </BastleFramework.BastleTraitDef>

  <!-- Cheap stat traits for the Common pool. -->
  <BastleFramework.BastleTraitDef>
    <defName>BF_Clotting</defName>
    <label>clotting</label>
    <description>Its blood thickens fast. Wounds bleed less than they should.</description>
    <rumor>barely bleeds, however deep you cut it</rumor>
    <namePrefix>clotting</namePrefix>
    <scalesWithRarity>true</scalesWithRarity>
    <requiresFlesh>true</requiresFlesh>
    <disallowConstructs>true</disallowConstructs>
    <exclusionTags><li>BF_Blood</li></exclusionTags>
    <discoverWhen><li>TakesDamage</li></discoverWhen>
    <stage>
      <totalBleedFactor>0.7</totalBleedFactor>
    </stage>
  </BastleFramework.BastleTraitDef>

  <BastleFramework.BastleTraitDef>
    <defName>BF_Hardy</defName>
    <label>hardy</label>
    <description>It is tougher than it looks and keeps fighting when others of its kind have fallen.</description>
    <rumor>takes more to kill it than any other of its kind</rumor>
    <namePrefix>hardy</namePrefix>
    <scalesWithRarity>true</scalesWithRarity>
    <healthScaleFactor>1.12</healthScaleFactor>
    <discoverWhen>
      <li>TakesDamage</li>
      <li>Dies</li>
    </discoverWhen>
  </BastleFramework.BastleTraitDef>

</Defs>
