<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Material traits: never rolled (commonality 0). A creature of the material
       always has them; see Patches/BF_Materials.xml. The material already shows in
       the name, so most of these have no name part of their own. -->

  <!-- Uranium. -->
  <BastleFramework.BastleTraitDef>
    <defName>BF_Irradiated</defName>
    <label>irradiated</label>
    <description>Its uranium body poisons everything living within 3 tiles, friend or foe, with toxic buildup.</description>
    <namePrefix>irradiated</namePrefix>
    <visible>true</visible>
    <commonality>0</commonality>
    <pointCost>0</pointCost>
    <heritable>false</heritable>
    <overlays>
      <li>
        <color>(0.4, 1.0, 0.3, 0.18)</color>
        <pulseSpeed>0.5</pulseSpeed>
        <pulseMin>0.3</pulseMin>
      </li>
    </overlays>
    <!-- Sickly green light seeping up through the metal. -->
    <surfaces>
      <li Class="BastleFramework.BastleSurface_Flow">
        <color>(0.4, 1, 0.3, 0.4)</color>
        <coreColor>(0.8, 1, 0.6, 1)</coreColor>
        <threshold>0.55</threshold>
        <coreThreshold>0.85</coreThreshold>
        <loopTicks>480</loopTicks>
        <frames>32</frames>
        <pulseSpeed>0.5</pulseSpeed>
        <pulseMin>0.6</pulseMin>
      </li>
    </surfaces>
    <glow>
      <radius>3</radius>
      <color>(80,220,60,0)</color>
    </glow>
    <traitClass>BastleFramework.BastleTrait_Aura</traitClass>
    <modExtensions>
      <li Class="BastleFramework.AuraParams">
        <radius>3.9</radius>
        <hediff>ToxicBuildup</hediff>
        <!-- Fast enough to show after a few seconds beside it (toxic buildup becomes
             visible at 0.04 and fades 0.08/day); lethal after about 3 minutes in
             contact. Cut by the same resistances as toxic fallout. -->
        <severityPerDay>6</severityPerDay>
        <resistStats>
          <li>ToxicResistance</li>
          <li>ToxicEnvironmentResistance</li>
        </resistStats>
        <affectsAllies>true</affectsAllies>
        <affectsNeutrals>true</affectsNeutrals>
        <affectsEnemies>true</affectsEnemies>
        <affectsEntities>true</affectsEntities>
        <whileDowned>true</whileDowned>
        <ringColor>(0.4, 1.0, 0.3, 1)</ringColor>
        <showLinks>true</showLinks>
      </li>
    </modExtensions>
  </BastleFramework.BastleTraitDef>

  <!-- Gold. Worth a fortune, alive or as a statue. -->
  <BastleFramework.BastleTraitDef>
    <defName>BF_Gilded</defName>
    <label>gilded</label>
    <description>Its golden body is worth a fortune to any trader.</description>
    <visible>true</visible>
    <commonality>0</commonality>
    <pointCost>0</pointCost>
    <heritable>false</heritable>
    <marketValuePercent>1.0</marketValuePercent>
    <surfaces>
      <li Class="BastleFramework.BastleSurface_Sheen">
        <color>(1, 0.85, 0.4, 0.55)</color>
      </li>
      <li Class="BastleFramework.BastleSurface_Glints">
        <color>(1, 0.92, 0.6, 0.9)</color>
        <count>1</count>
      </li>
    </surfaces>
  </BastleFramework.BastleTraitDef>

  <!-- Plasteel. -->
  <BastleFramework.BastleTraitDef>
    <defName>BF_Unyielding</defName>
    <label>unyielding</label>
    <description>Its plasteel body can't be staggered, and every hit does less damage.</description>
    <visible>true</visible>
    <commonality>0</commonality>
    <pointCost>0</pointCost>
    <heritable>false</heritable>
    <stage>
      <statFactors>
        <StaggerDurationFactor>0</StaggerDurationFactor>
        <IncomingDamageFactor>0.85</IncomingDamageFactor>
      </statFactors>
    </stage>
  </BastleFramework.BastleTraitDef>

  <!-- Silver. -->
  <BastleFramework.BastleTraitDef>
    <defName>BF_Argent</defName>
    <label>argent</label>
    <description>Silver wards off the unnatural. Psychic effects touch it half as much, and its melee strikes deal 50% extra damage to entities, shamblers and ghouls.</description>
    <visible>true</visible>
    <commonality>0</commonality>
    <pointCost>0</pointCost>
    <heritable>false</heritable>
    <traitClass>BastleFramework.BastleTrait_BaneDamage</traitClass>
    <surfaces>
      <li Class="BastleFramework.BastleSurface_Sheen">
        <color>(0.9, 0.95, 1, 0.5)</color>
      </li>
    </surfaces>
    <stage>
      <statFactors>
        <PsychicSensitivity>0.5</PsychicSensitivity>
      </statFactors>
    </stage>
  </BastleFramework.BastleTraitDef>

  <!-- Wood. -->
  <BastleFramework.BastleTraitDef>
    <defName>BF_Kindling</defName>
    <label>kindling</label>
    <!-- The wood material itself already makes it weak to fire (Materials settings). -->
    <description>Its wooden body burns easily, and while it burns, its melee strikes can set whatever they hit alight.</description>
    <visible>true</visible>
    <commonality>0</commonality>
    <pointCost>0</pointCost>
    <heritable>false</heritable>
    <traitClass>BastleFramework.BastleTrait_Kindling</traitClass>
  </BastleFramework.BastleTraitDef>

  <!-- Granite. -->
  <BastleFramework.BastleTraitDef>
    <defName>BF_Stonebound</defName>
    <label>stonebound</label>
    <description>Its granite body is slow and heavy, and blunt blows barely chip it.</description>
    <visible>true</visible>
    <commonality>0</commonality>
    <pointCost>0</pointCost>
    <heritable>false</heritable>
    <stage>
      <statFactors>
        <MoveSpeed>0.85</MoveSpeed>
      </statFactors>
      <damageFactors>
        <Blunt>0.6</Blunt>
      </damageFactors>
    </stage>
  </BastleFramework.BastleTraitDef>

  <!-- Bioferrite (Anomaly). -->
  <BastleFramework.BastleTraitDef MayRequire="Ludeon.RimWorld.Anomaly">
    <defName>BF_VoidTouched</defName>
    <label>void-touched</label>
    <description>Something dark moves under the surface of its bioferrite body. It is deaf to psychic effects.</description>
    <namePrefix>void-touched</namePrefix>
    <visible>true</visible>
    <commonality>0</commonality>
    <pointCost>0</pointCost>
    <heritable>false</heritable>
    <tags><li>Void</li></tags>
    <overlays>
      <li>
        <color>(0.35, 0.05, 0.1, 0.35)</color>
        <pulseSpeed>0.35</pulseSpeed>
        <pulseMin>0.2</pulseMin>
      </li>
    </overlays>
    <!-- Something dark moving under the surface: slow, blended, near black. -->
    <surfaces>
      <li Class="BastleFramework.BastleSurface_Flow">
        <color>(0.12, 0.02, 0.08, 0.5)</color>
        <coreColor>(0.3, 0.05, 0.12, 1)</coreColor>
        <threshold>0.5</threshold>
        <coreThreshold>0.85</coreThreshold>
        <additive>false</additive>
        <loopTicks>900</loopTicks>
        <scrolls>1</scrolls>
        <frames>24</frames>
        <evolveCells>2</evolveCells>
      </li>
    </surfaces>
    <stage>
      <statFactors>
        <PsychicSensitivity>0</PsychicSensitivity>
      </statFactors>
    </stage>
  </BastleFramework.BastleTraitDef>

</Defs>
