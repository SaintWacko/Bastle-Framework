<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Drawbacks: negative points give budget back and only roll through the
       drawback chance in the mod settings. -->

  <TitanFramework.TitanTraitDef>
    <defName>TF_Brittle</defName>
    <label>brittle</label>
    <description>Something about it is fragile. It takes more damage from every hit.</description>
    <namePrefix>brittle</namePrefix>
    <nameOrder>-10</nameOrder>
    <pointCost>-1</pointCost>
    <commonality>0.5</commonality>
    <scalesWithRarity>true</scalesWithRarity>
    <exclusionTags><li>TF_Toughness</li></exclusionTags>
    <discoverWhen><li>TakesDamage</li></discoverWhen>
    <stage>
      <statFactors>
        <IncomingDamageFactor>1.3</IncomingDamageFactor>
      </statFactors>
    </stage>
  </TitanFramework.TitanTraitDef>

  <TitanFramework.TitanTraitDef>
    <defName>TF_Tinderhide</defName>
    <label>tinderhide</label>
    <description>Its body catches fire easily. It takes double damage from flames.</description>
    <namePrefix>tinderhide</namePrefix>
    <nameOrder>-10</nameOrder>
    <pointCost>-1</pointCost>
    <exclusionTags><li>TF_FireAffinity</li></exclusionTags>
    <discoverWhen><li>TakesDamage</li></discoverWhen>
    <stage>
      <damageFactors>
        <Flame>2</Flame>
        <Burn>2</Burn>
      </damageFactors>
    </stage>
  </TitanFramework.TitanTraitDef>

  <TitanFramework.TitanTraitDef>
    <defName>TF_Sluggish</defName>
    <label>sluggish</label>
    <description>It moves slowly, even for its kind.</description>
    <namePrefix>sluggish</namePrefix>
    <nameOrder>-10</nameOrder>
    <pointCost>-1</pointCost>
    <exclusionTags><li>TF_Speed</li></exclusionTags>
    <discoverWhen>
      <li>Attacks</li>
      <li>JoinsColony</li>
      <li>Dies</li>
    </discoverWhen>
    <stage>
      <statFactors>
        <MoveSpeed>0.8</MoveSpeed>
      </statFactors>
    </stage>
  </TitanFramework.TitanTraitDef>

  <TitanFramework.TitanTraitDef>
    <defName>TF_Ravenous</defName>
    <label>ravenous</label>
    <description>It is always hungry, and eats far more than others of its kind.</description>
    <namePrefix>ravenous</namePrefix>
    <nameOrder>-10</nameOrder>
    <pointCost>-1</pointCost>
    <allowMechanoids>false</allowMechanoids>
    <exclusionTags><li>TF_Hunger</li></exclusionTags>
    <tags><li>Utility</li></tags>
    <discoverWhen>
      <li>JoinsColony</li>
      <li>Dies</li>
    </discoverWhen>
    <stage>
      <hungerRateFactor>1.6</hungerRateFactor>
    </stage>
  </TitanFramework.TitanTraitDef>

  <TitanFramework.TitanTraitDef>
    <defName>TF_Sickly</defName>
    <label>sickly</label>
    <description>Its body fights off disease slowly.</description>
    <namePrefix>sickly</namePrefix>
    <nameOrder>-10</nameOrder>
    <pointCost>-1</pointCost>
    <requiresFlesh>true</requiresFlesh>
    <disallowConstructs>true</disallowConstructs>
    <tags><li>Utility</li></tags>
    <discoverWhen>
      <li>JoinsColony</li>
      <li>Dies</li>
    </discoverWhen>
    <stage>
      <statFactors>
        <ImmunityGainSpeed>0.7</ImmunityGainSpeed>
      </statFactors>
    </stage>
  </TitanFramework.TitanTraitDef>

  <TitanFramework.TitanTraitDef>
    <defName>TF_CloudedEyes</defName>
    <label>clouded eyes</label>
    <description>A milky film covers its eyes. It sees poorly.</description>
    <namePrefix>cloudy-eyed</namePrefix>
    <nameOrder>-10</nameOrder>
    <pointCost>-1</pointCost>
    <requiresFlesh>true</requiresFlesh>
    <exclusionTags><li>TF_Sight</li></exclusionTags>
    <discoverWhen>
      <li>Attacks</li>
      <li>JoinsColony</li>
    </discoverWhen>
    <stage>
      <capMods>
        <li>
          <capacity>Sight</capacity>
          <offset>-0.3</offset>
        </li>
      </capMods>
    </stage>
  </TitanFramework.TitanTraitDef>

  <TitanFramework.TitanTraitDef>
    <defName>TF_Lame</defName>
    <label>lame</label>
    <description>An old injury that never healed right. It limps.</description>
    <namePrefix>lame</namePrefix>
    <nameOrder>-10</nameOrder>
    <pointCost>-1</pointCost>
    <requiresFlesh>true</requiresFlesh>
    <exclusionTags><li>TF_Speed</li></exclusionTags>
    <discoverWhen>
      <li>Attacks</li>
      <li>JoinsColony</li>
    </discoverWhen>
    <stage>
      <capMods>
        <li>
          <capacity>Moving</capacity>
          <offset>-0.2</offset>
        </li>
      </capMods>
    </stage>
  </TitanFramework.TitanTraitDef>

  <TitanFramework.TitanTraitDef>
    <defName>TF_Bleeder</defName>
    <label>bleeder</label>
    <description>Its blood doesn't clot well. Wounds bleed twice as fast.</description>
    <namePrefix>thin-blooded</namePrefix>
    <nameOrder>-10</nameOrder>
    <pointCost>-1</pointCost>
    <requiresFlesh>true</requiresFlesh>
    <disallowConstructs>true</disallowConstructs>
    <discoverWhen><li>TakesDamage</li></discoverWhen>
    <stage>
      <totalBleedFactor>2</totalBleedFactor>
    </stage>
  </TitanFramework.TitanTraitDef>

  <TitanFramework.TitanTraitDef>
    <defName>TF_Restless</defName>
    <label>restless</label>
    <description>It sleeps badly and tires quickly.</description>
    <namePrefix>restless</namePrefix>
    <nameOrder>-10</nameOrder>
    <pointCost>-1</pointCost>
    <allowMechanoids>false</allowMechanoids>
    <exclusionTags><li>TF_Rest</li></exclusionTags>
    <tags><li>Utility</li></tags>
    <discoverWhen>
      <li>JoinsColony</li>
      <li>Dies</li>
    </discoverWhen>
    <stage>
      <restFallFactor>1.5</restFallFactor>
    </stage>
  </TitanFramework.TitanTraitDef>

  <!-- Its stage only applies while it stands in light (TitanTrait_Lightsick). -->
  <TitanFramework.TitanTraitDef>
    <defName>TF_Lightsick</defName>
    <label>lightsick</label>
    <description>It is a creature of the dark. In bright light it squints, stumbles and fights poorly.</description>
    <namePrefix>lightsick</namePrefix>
    <nameOrder>-10</nameOrder>
    <pointCost>-1</pointCost>
    <traitClass>TitanFramework.TitanTrait_Lightsick</traitClass>
    <requiresFlesh>true</requiresFlesh>
    <exclusionTags><li>TF_Sight</li></exclusionTags>
    <discoverWhen>
      <li>Attacks</li>
      <li>JoinsColony</li>
    </discoverWhen>
    <stage>
      <capMods>
        <li>
          <capacity>Sight</capacity>
          <offset>-0.3</offset>
        </li>
      </capMods>
      <statFactors>
        <MoveSpeed>0.85</MoveSpeed>
        <MeleeHitChance>0.85</MeleeHitChance>
      </statFactors>
    </stage>
  </TitanFramework.TitanTraitDef>

  <!-- Can't breed, so it can't pass this on either. -->
  <TitanFramework.TitanTraitDef>
    <defName>TF_Barren</defName>
    <label>barren</label>
    <description>It cannot have offspring.</description>
    <namePrefix>barren</namePrefix>
    <nameOrder>-10</nameOrder>
    <pointCost>-0.5</pointCost>
    <heritable>false</heritable>
    <requiresFlesh>true</requiresFlesh>
    <allowHumanlikes>false</allowHumanlikes>
    <tags><li>Utility</li></tags>
    <discoverWhen>
      <li>JoinsColony</li>
      <li>Dies</li>
    </discoverWhen>
    <hediffs>
      <li><hediff>TF_BarrenBody</hediff></li>
    </hediffs>
  </TitanFramework.TitanTraitDef>

  <!-- Diet drawback: a tamed one eats steel from your stockpile. Revealed by eating it. -->
  <TitanFramework.TitanTraitDef>
    <defName>TF_MetalHungry</defName>
    <label>metal-hungry</label>
    <description>It craves metal and will chew through a stockpile of steel when it gets hungry.</description>
    <namePrefix>metal-hungry</namePrefix>
    <nameOrder>-10</nameOrder>
    <pointCost>-1</pointCost>
    <allowMechanoids>false</allowMechanoids>
    <tags><li>Utility</li></tags>
    <diet>
      <extraFoods>
        <li><thing>Steel</thing><nutrition>0.05</nutrition></li>
      </extraFoods>
    </diet>
  </TitanFramework.TitanTraitDef>

</Defs>
