<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- EXAMPLE TRAITS for testing the framework. Move these to the dungeon mod (or
       delete them) before the framework is published: anything here gets rolled
       by every mod that calls TitanUtility.RollTraits without a validator. -->

  <!-- Visible: identified from the start, and in the name from the start. -->
  <TitanFramework.TitanTraitDef>
    <defName>TF_Example_Flaming</defName>
    <label>flaming</label>
    <description>Its body burns without being consumed. Fire barely hurts it and it shrugs off the cold.</description>
    <visible>true</visible>
    <namePrefix>flaming</namePrefix>
    <pointCost>2</pointCost>
    <exclusionTags><li>TF_Element</li></exclusionTags>
    <tags><li>Fire</li></tags>
    <!-- A faint warm tint, a few flickering vanilla fire sprites on the body, and
         flame licks, embers and smoke rising off it. -->
    <overlays>
      <li>
        <color>(1.0, 0.4, 0.05, 0.35)</color>
        <scale>1.0</scale>
        <layer>1</layer>
        <pulseSpeed>1.3</pulseSpeed>
        <pulseMin>0.5</pulseMin>
      </li>
    </overlays>
    <flames>
      <li>
        <count>3</count>
        <size>0.3~0.45</size>
        <color>(1.0, 0.9, 0.8, 0.8)</color>
      </li>
    </flames>
    <effecters>
      <li>TF_Effecter_Embers</li>
    </effecters>
    <stage>
      <statOffsets>
        <ComfyTemperatureMin>-40</ComfyTemperatureMin>
      </statOffsets>
      <damageFactors>
        <Flame>0.2</Flame>
        <Burn>0.2</Burn>
      </damageFactors>
    </stage>
  </TitanFramework.TitanTraitDef>

  <!-- Hidden attack: revealed the first time it bites with the venomous fangs. -->
  <TitanFramework.TitanTraitDef>
    <defName>TF_Example_Venomous</defName>
    <label>venomous</label>
    <description>Its bite carries a poison that builds up in the victim's body.</description>
    <namePrefix>venomous</namePrefix>
    <pointCost>2</pointCost>
    <requiresFlesh>true</requiresFlesh>
    <discoverWhen>
      <li>UsesGrantedVerb</li>
      <li>Dies</li>
    </discoverWhen>
    <hediffs>
      <li><hediff>TF_Example_VenomFangs</hediff></li>
    </hediffs>
  </TitanFramework.TitanTraitDef>

  <!-- Hidden defence: revealed when it takes a hit. -->
  <TitanFramework.TitanTraitDef>
    <defName>TF_Example_Ironhide</defName>
    <label>ironhide</label>
    <description>Its hide turns blades and dulls blows.</description>
    <namePrefix>ironhide</namePrefix>
    <nameOrder>10</nameOrder>
    <pointCost>2</pointCost>
    <exclusionTags><li>TF_Toughness</li></exclusionTags>
    <discoverWhen><li>TakesDamage</li></discoverWhen>
    <stage>
      <statOffsets>
        <ArmorRating_Sharp>0.4</ArmorRating_Sharp>
        <ArmorRating_Blunt>0.25</ArmorRating_Blunt>
      </statOffsets>
    </stage>
  </TitanFramework.TitanTraitDef>

  <!-- Hidden passive with a suffix. -->
  <TitanFramework.TitanTraitDef>
    <defName>TF_Example_OfTheDeep</defName>
    <label>of the deep</label>
    <description>It regrows lost flesh with unnatural speed.</description>
    <nameSuffix>of the deep</nameSuffix>
    <pointCost>3</pointCost>
    <discoverWhen><li>TakesDamage</li></discoverWhen>
    <stage>
      <regeneration>60</regeneration>
      <naturalHealingFactor>2</naturalHealingFactor>
    </stage>
  </TitanFramework.TitanTraitDef>

  <!-- Drawback: negative cost gives budget back. -->
  <TitanFramework.TitanTraitDef>
    <defName>TF_Example_Brittle</defName>
    <label>brittle</label>
    <description>Something about it is fragile. It takes more damage from every hit.</description>
    <namePrefix>brittle</namePrefix>
    <nameOrder>-10</nameOrder>
    <pointCost>-1</pointCost>
    <commonality>0.5</commonality>
    <exclusionTags><li>TF_Toughness</li></exclusionTags>
    <discoverWhen><li>TakesDamage</li></discoverWhen>
    <stage>
      <statFactors>
        <IncomingDamageFactor>1.3</IncomingDamageFactor>
      </statFactors>
    </stage>
  </TitanFramework.TitanTraitDef>

  <!-- Rising embers, a faint glow and the odd wisp of smoke. Built from vanilla flecks and motes. -->
  <EffecterDef>
    <defName>TF_Effecter_Embers</defName>
    <children>
      <!-- Animated flame licks rising off the body (Biotech's fire-spew art; skipped without Biotech). -->
      <li MayRequire="Ludeon.RimWorld.Biotech">
        <subEffecterClass>SubEffecter_SprayerChance</subEffecterClass>
        <fleckDef>FireSpew_A</fleckDef>
        <spawnLocType>OnSource</spawnLocType>
        <chancePerTick>0.12</chancePerTick>
        <scale>0.35~0.55</scale>
        <angle>-12~12</angle>
        <speed>0.4~0.8</speed>
        <positionRadius>0.35</positionRadius>
        <color>(1.0, 0.85, 0.7, 0.75)</color>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SprayerChance</subEffecterClass>
        <fleckDef>FireGlow</fleckDef>
        <spawnLocType>OnSource</spawnLocType>
        <chancePerTick>0.04</chancePerTick>
        <scale>0.7~1.1</scale>
        <positionRadius>0.25</positionRadius>
        <color>(1.0, 0.6, 0.2, 0.6)</color>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SprayerChance</subEffecterClass>
        <moteDef>Mote_SparkThrown</moteDef>
        <spawnLocType>OnSource</spawnLocType>
        <chancePerTick>0.2</chancePerTick>
        <scale>0.15~0.35</scale>
        <airTime>0.3~0.8</airTime>
        <angle>-30~30</angle>
        <speed>0.6~1.4</speed>
        <rotationRate>-120~120</rotationRate>
        <positionRadius>0.35</positionRadius>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SprayerChance</subEffecterClass>
        <fleckDef>Smoke</fleckDef>
        <spawnLocType>OnSource</spawnLocType>
        <chancePerTick>0.015</chancePerTick>
        <scale>0.5~0.9</scale>
        <speed>0.2~0.4</speed>
        <angle>-20~20</angle>
        <rotationRate>-10~10</rotationRate>
        <positionRadius>0.3</positionRadius>
        <color>(0.4, 0.4, 0.4, 0.5)</color>
      </li>
    </children>
  </EffecterDef>

  <HediffDef>
    <defName>TF_Example_VenomFangs</defName>
    <label>venomous fangs</label>
    <description>Fangs that inject a building poison.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <scenarioCanAdd>false</scenarioCanAdd>
    <stages>
      <li><becomeVisible>false</becomeVisible></li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_VerbGiver">
        <tools>
          <li>
            <label>venomous fangs</label>
            <capacities><li>ToxicBite</li></capacities>
            <power>10</power>
            <cooldownTime>2</cooldownTime>
            <chanceFactor>2</chanceFactor>
          </li>
        </tools>
      </li>
    </comps>
  </HediffDef>

</Defs>
