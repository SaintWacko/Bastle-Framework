<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Hediffs granted alongside traits. Hidden from the health tab: the trait itself
       is what the player learns about. -->

  <HediffDef Name="BF_TraitHediffBase" Abstract="True">
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <scenarioCanAdd>false</scenarioCanAdd>
    <stages>
      <li><becomeVisible>false</becomeVisible></li>
    </stages>
  </HediffDef>

  <!-- Given by the rallying aura and refreshed while in range. -->
  <HediffDef>
    <defName>BF_Rallied</defName>
    <label>rallied</label>
    <description>Steadied by a nearby rallying creature.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(1.0, 0.8, 0.35)</defaultLabelColor>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <scenarioCanAdd>false</scenarioCanAdd>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>400</disappearsAfterTicks>
        <showRemainingTime>false</showRemainingTime>
      </li>
      <!-- With Ideology, Combat Command's line back to the creature rallying it. -->
      <li Class="HediffCompProperties_Link" MayRequire="Ludeon.RimWorld.Ideology">
        <requireLinkOnOtherPawn>false</requireLinkOnOtherPawn>
        <customMote>Mote_CombatCommandLinkLine</customMote>
      </li>
    </comps>
    <stages>
      <li>
        <painFactor>0.7</painFactor>
        <statFactors>
          <MeleeDamageFactor>1.2</MeleeDamageFactor>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

  <HediffDef ParentName="BF_TraitHediffBase">
    <defName>BF_VenomFangs</defName>
    <label>venomous fangs</label>
    <description>Fangs that inject a building poison.</description>
    <!-- Bites as hard as the creature's strongest natural attack, so the poison suits its size.
         The power below only applies to a race with no attacks of its own. -->
    <modExtensions>
      <li Class="BastleFramework.BastleScaledAttack"><factor>1</factor></li>
    </modExtensions>
    <comps>
      <li Class="HediffCompProperties_VerbGiver">
        <tools>
          <li>
            <label>venomous fangs</label>
            <capacities><li>ToxicBite</li></capacities>
            <power>10</power>
            <cooldownTime>2</cooldownTime>
            <chanceFactor>2</chanceFactor>
          </li>
        </tools>
      </li>
    </comps>
  </HediffDef>

  <HediffDef ParentName="BF_TraitHediffBase">
    <defName>BF_VirulentFangs</defName>
    <label>virulent fangs</label>
    <description>Fangs that inject a fast, overwhelming poison.</description>
    <modExtensions>
      <li Class="BastleFramework.BastleScaledAttack"><factor>1.75</factor></li>
    </modExtensions>
    <comps>
      <li Class="HediffCompProperties_VerbGiver">
        <tools>
          <li>
            <label>virulent fangs</label>
            <capacities><li>ToxicBite</li></capacities>
            <power>18</power>
            <cooldownTime>2</cooldownTime>
            <chanceFactor>3</chanceFactor>
          </li>
        </tools>
      </li>
    </comps>
  </HediffDef>

  <HediffDef ParentName="BF_TraitHediffBase">
    <defName>BF_BonebreakerBlow</defName>
    <label>bonebreaker blow</label>
    <description>A crushing blow that can stun.</description>
    <modExtensions>
      <li Class="BastleFramework.BastleScaledAttack"><factor>1.3</factor></li>
    </modExtensions>
    <comps>
      <li Class="HediffCompProperties_VerbGiver">
        <tools>
          <li>
            <label>crushing blow</label>
            <capacities><li>Blunt</li></capacities>
            <power>14</power>
            <cooldownTime>2.6</cooldownTime>
            <chanceFactor>1.5</chanceFactor>
            <extraMeleeDamages>
              <li>
                <def>Stun</def>
                <amount>10</amount>
              </li>
            </extraMeleeDamages>
          </li>
        </tools>
      </li>
    </comps>
  </HediffDef>

  <HediffDef ParentName="BF_TraitHediffBase">
    <defName>BF_StormStrike</defName>
    <label>storm strike</label>
    <description>A strike that carries an electric shock.</description>
    <modExtensions>
      <li Class="BastleFramework.BastleScaledAttack"><factor>1</factor></li>
    </modExtensions>
    <comps>
      <li Class="HediffCompProperties_VerbGiver">
        <tools>
          <li>
            <label>shocking strike</label>
            <capacities><li>Blunt</li></capacities>
            <power>10</power>
            <cooldownTime>2</cooldownTime>
            <chanceFactor>1.5</chanceFactor>
            <extraMeleeDamages>
              <li>
                <def>EMP</def>
                <amount>12</amount>
              </li>
            </extraMeleeDamages>
          </li>
        </tools>
      </li>
    </comps>
  </HediffDef>

  <HediffDef ParentName="BF_TraitHediffBase">
    <defName>BF_VolatileCore</defName>
    <label>volatile core</label>
    <description>Something unstable that explodes when its host dies.</description>
    <comps>
      <li Class="HediffCompProperties_ExplodeOnDeath">
        <explosionRadius>2.9</explosionRadius>
        <damageDef>Bomb</damageDef>
        <damageAmount>25</damageAmount>
      </li>
    </comps>
  </HediffDef>

  <!-- Given to enemies near a bastle with a dread aura; fades once they leave. -->
  <HediffDef>
    <defName>BF_DreadStruck</defName>
    <label>dread</label>
    <description>Gripped by dread from a nearby creature.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.6, 0.4, 0.7)</defaultLabelColor>
    <isBad>true</isBad>
    <everCurableByItem>false</everCurableByItem>
    <scenarioCanAdd>false</scenarioCanAdd>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>400</disappearsAfterTicks>
        <showRemainingTime>false</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.1</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.15</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <HediffDef ParentName="BF_TraitHediffBase">
    <defName>BF_BarrenBody</defName>
    <label>barren</label>
    <description>Unable to have offspring.</description>
    <preventsPregnancy>true</preventsPregnancy>
  </HediffDef>

</Defs>
