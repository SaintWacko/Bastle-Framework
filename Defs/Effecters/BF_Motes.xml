<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Aura ground glow: Combat Command's mask texture in white, so each aura tints it
       (BastleTrait_Aura sets instanceColor from AuraParams). The texture ships with
       Ideology, so without it this def doesn't load and auras show only their ring.
       Maintained every tick by MapComponent_BastleVisuals and dies without it. -->
  <ThingDef ParentName="MoteBase" MayRequire="Ludeon.RimWorld.Ideology">
    <defName>BF_Mote_AuraGlow</defName>
    <thingClass>MoteAttached</thingClass>
    <altitudeLayer>LightingOverlay</altitudeLayer>
    <drawOffscreen>true</drawOffscreen>
    <mote>
      <solidTime>9999999</solidTime>
      <needsMaintenance>true</needsMaintenance>
      <!-- The mote ticks before map components maintain it, so it must survive one
           unmaintained tick or it would be destroyed and respawned every tick. -->
      <fadeOutUnmaintained>true</fadeOutUnmaintained>
      <fadeOutTime>0.1</fadeOutTime>
    </mote>
    <graphicData>
      <graphicClass>Graphic_Mote</graphicClass>
      <texPath>Things/Mote/CombatCommandMask</texPath>
      <shaderType>MoteGlow</shaderType>
      <drawSize>2</drawSize>
    </graphicData>
  </ThingDef>

  <!-- Aura link line: Combat Command's line, drawn through Graphic_Mote so
       BastleTrait_Aura can tint it per aura. Ideology's texture. -->
  <ThingDef ParentName="MoteBase" MayRequire="Ludeon.RimWorld.Ideology">
    <defName>BF_Mote_AuraLink</defName>
    <thingClass>MoteDualAttached</thingClass>
    <altitudeLayer>MoteLow</altitudeLayer>
    <mote>
      <fadeInTime>0.1</fadeInTime>
      <fadeOutTime>0.1</fadeOutTime>
      <solidTime>999999</solidTime>
      <needsMaintenance>true</needsMaintenance>
      <!-- Maintained after it ticks, like the glow: survive one tick's gap. -->
      <fadeOutUnmaintained>true</fadeOutUnmaintained>
      <rotateTowardsTarget>true</rotateTowardsTarget>
      <scaleToConnectTargets>true</scaleToConnectTargets>
    </mote>
    <graphicData>
      <graphicClass>Graphic_Mote</graphicClass>
      <shaderType>MoteGlow</shaderType>
      <texPath>Things/Mote/CombatCommandLinkLine</texPath>
    </graphicData>
  </ThingDef>

</Defs>
