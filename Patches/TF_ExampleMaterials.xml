<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- EXAMPLE: how a content mod gives a material its own traits. Every uranium
       creature gets TF_Example_Irradiated. Move to the dungeon mod (or delete)
       before the framework is published, along with Defs/Examples. -->
  <Operation Class="PatchOperationAddModExtension">
    <xpath>Defs/ThingDef[defName="Uranium"]</xpath>
    <value>
      <li Class="TitanFramework.TitanMaterialExtension">
        <traits>
          <li>TF_Example_Irradiated</li>
        </traits>
      </li>
    </value>
  </Operation>

</Patch>
